<UserControl x:Class="MozaPlugin.Devices.Ui.MozaFcsSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:MozaControls"
             xmlns:res="clr-namespace:MozaPlugin.Resources"
             xmlns:ui="clr-namespace:MozaPlugin.UI"
             xmlns:profilescommon="clr-namespace:SimHub.Plugins.ProfilesCommon;assembly=SimHub.Plugins"
             Padding="0"
             TextElement.Foreground="{DynamicResource TextBrush}"
             TextElement.FontFamily="{DynamicResource FontUi}"
             TextElement.FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ctrl:SharedResourceDictionary SharedSource="pack://application:,,,/MozaPlugin;component/Themes/MozaTheme.xaml"/>
                <ctrl:SharedResourceDictionary SharedSource="pack://application:,,,/MozaPlugin;component/Themes/MozaIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
                <Setter Property="Width" Value="180"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="AxisLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedHintText}">
                <Setter Property="Width" Value="120"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="AxisBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="12"/>
                <Setter Property="Width" Value="180"/>
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="100"/>
                <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
            </Style>
            <Style x:Key="SettingSlider" TargetType="Slider" BasedOn="{StaticResource MozaSlider}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="MinWidth" Value="80"/>
                <Setter Property="IsSnapToTickEnabled" Value="True"/>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource MozaButton}"/>
            <Style TargetType="Slider" BasedOn="{StaticResource MozaSlider}"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <ui:PluginBanners DockPanel.Dock="Top" Margin="5,5,5,0"/>
        <StackPanel DockPanel.Dock="Top" Margin="5">
            <StackPanel x:Name="NotDetectedPanel">
                <TextBlock Text="{x:Static res:Strings.Status_SearchingForFcs}" Foreground="Gray" FontStyle="Italic" Margin="0,10"/>
            </StackPanel>
        </StackPanel>

        <TabControl x:Name="FcsTabs" Style="{StaticResource MozaHeaderTabControl}" Margin="0,4,0,0"
                    Visibility="Collapsed" SelectionChanged="FcsTabs_SelectionChanged">
            <ctrl:TabStrip.TrailingContent>
                <!-- LED profile list (bound in code-behind). -->
                <StackPanel x:Name="DeviceProfileRow" Orientation="Horizontal" Visibility="Collapsed">
                    <profilescommon:ProfileList x:Name="DeviceProfileList" VerticalAlignment="Center"/>
                </StackPanel>
            </ctrl:TabStrip.TrailingContent>

            <!-- ==================== INPUTS ==================== -->
            <TabItem x:Name="InputsTab" Header="{x:Static res:Strings.TabHeader_Inputs}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource InnerCardBorder}" Margin="0,0,7,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource GreenBrush}"
                                             VerticalAlignment="Center" Margin="0,0,8,0"
                                             Effect="{StaticResource GreenGlowEffect}"/>
                                    <TextBlock Text="{x:Static res:Strings.Section_LiveAxes}" Style="{StaticResource SectionTitleText}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{x:Static res:Strings.Label_FcsThrottleLever}" Style="{StaticResource AxisLabel}"/>
                                    <ProgressBar x:Name="ThrottleBar" Style="{StaticResource AxisBar}" Foreground="{StaticResource GreenBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{x:Static res:Strings.Label_FcsJoystickX}" Style="{StaticResource AxisLabel}"/>
                                    <ProgressBar x:Name="JoystickXBar" Style="{StaticResource AxisBar}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{x:Static res:Strings.Label_FcsJoystickY}" Style="{StaticResource AxisLabel}"/>
                                    <ProgressBar x:Name="JoystickYBar" Style="{StaticResource AxisBar}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{x:Static res:Strings.Label_FcsJoystickTwist}" Style="{StaticResource AxisLabel}"/>
                                    <ProgressBar x:Name="TwistBar" Style="{StaticResource AxisBar}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{x:Static res:Strings.Label_FcsThumbstickX}" Style="{StaticResource AxisLabel}"/>
                                    <ProgressBar x:Name="ThumbXBar" Style="{StaticResource AxisBar}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static res:Strings.Label_FcsThumbstickY}" Style="{StaticResource AxisLabel}"/>
                                    <ProgressBar x:Name="ThumbYBar" Style="{StaticResource AxisBar}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource InnerCardBorder}" Margin="7,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource GreenBrush}"
                                             VerticalAlignment="Center" Margin="0,0,8,0"
                                             Effect="{StaticResource GreenGlowEffect}"/>
                                    <TextBlock Text="{x:Static res:Strings.Section_ActiveButtons}" Style="{StaticResource SectionTitleText}"/>
                                </StackPanel>
                                <TextBlock x:Name="ActiveButtonsText"
                                           FontFamily="{StaticResource FontMono}" FontSize="12"
                                           Foreground="{StaticResource TextDimBrush}"
                                           TextWrapping="Wrap" Text="{x:Static res:Strings.Option_None}"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Label_RightRod}" Style="{StaticResource KvKeyText}" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" x:Name="RightRodText" Style="{StaticResource KvValueText}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ctrl:SectionCard Grid.Column="0" Title="{x:Static res:Strings.Section_Calibration}"
                                          Icon="{StaticResource IconCal}" Margin="0,0,7,14">
                            <StackPanel x:Name="CalibrationRows"/>
                        </ctrl:SectionCard>
                        <ctrl:SectionCard Grid.Column="1" x:Name="ModesCard" Title="{x:Static res:Strings.Section_JoystickModes}"
                                          Icon="{StaticResource IconShift}" Margin="7,0,0,14">
                            <StackPanel x:Name="ModeRows"/>
                        </ctrl:SectionCard>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- ==================== LEDS ==================== -->
            <TabItem x:Name="LedsTab" Header="{x:Static res:Strings.TabHeader_Leds}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ctrl:SectionCard Grid.Column="0" Title="{x:Static res:Strings.Section_Mode}"
                                          Icon="{StaticResource IconBolt}" Margin="0,0,7,14">
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="{x:Static res:Strings.SliderLabel_ButtonLightMode}" Style="{StaticResource FieldLabel}"/>
                                <!-- Index = device value: 0 off, 1 non-telemetry, 2 telemetry. -->
                                <ctrl:SegmentedControl x:Name="LightModeCombo" SelectionChanged="LightModeCombo_Changed">
                                    <ListBoxItem Content="{x:Static res:Strings.Option_Off}"/>
                                    <ListBoxItem Content="{x:Static res:Strings.Option_On}"/>
                                    <ListBoxItem Content="{x:Static res:Strings.Option_SimHubMode}"/>
                                </ctrl:SegmentedControl>
                            </StackPanel>
                        </ctrl:SectionCard>

                        <ctrl:SectionCard Grid.Column="1" Title="{x:Static res:Strings.Section_Brightness}"
                                          Icon="{StaticResource IconLed}" Margin="7,0,0,14">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Brightness}" Style="{StaticResource FieldLabel}"/>
                                <Slider Grid.Column="1" x:Name="BrightnessSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="BrightnessSlider_ValueChanged"/>
                                <TextBox Grid.Column="2" x:Name="BrightnessValue" Style="{StaticResource SliderValueEditBox}" ui:SliderValueBox.Slider="{Binding ElementName=BrightnessSlider}" Text="80"/>
                            </Grid>
                        </ctrl:SectionCard>
                    </Grid>

                    <ctrl:SectionCard Title="{x:Static res:Strings.Section_LedColors}" Icon="{StaticResource IconLed}" Margin="0,0,0,14">
                        <StackPanel x:Name="ColorPanel" Margin="0,4,0,0"/>
                    </ctrl:SectionCard>

                    <ctrl:SectionCard Title="{x:Static res:Strings.Section_IdleEffect}" Icon="{StaticResource IconLed}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="{x:Static res:Strings.SliderLabel_IdleAnimation}" Style="{StaticResource FieldLabel}"/>
                                <!-- Index = device value 0..6. -->
                                <ctrl:SegmentedControl x:Name="StandbyModeCombo" SelectionChanged="StandbyModeCombo_Changed">
                                    <ListBoxItem Content="{x:Static res:Strings.Option_Off}"/>
                                    <ListBoxItem Content="{x:Static res:Strings.Option_Constant}"/>
                                    <ListBoxItem Content="{x:Static res:Strings.Option_Breath}"/>
                                    <ListBoxItem Content="{x:Static res:Strings.Option_Cycle}"/>
                                    <ListBoxItem Content="{x:Static res:Strings.Option_Rainbow}"/>
                                    <ListBoxItem Content="{x:Static res:Strings.Option_Flow}"/>
                                    <ListBoxItem x:Name="PulseItem" Content="{x:Static res:Strings.Option_RgbPulse}"/>
                                </ctrl:SegmentedControl>
                            </StackPanel>
                            <Grid x:Name="StandbySpeedRow" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_StandbySpeedMs}" Style="{StaticResource FieldLabel}"/>
                                <!-- Pit House bounds: 125..5000 ms. -->
                                <Slider Grid.Column="1" x:Name="StandbySpeedSlider" Style="{StaticResource SettingSlider}" Minimum="125" Maximum="5000" TickFrequency="1" ValueChanged="StandbySpeedSlider_ValueChanged"/>
                                <TextBox Grid.Column="2" x:Name="StandbySpeedValue" Style="{StaticResource SliderValueEditBox}" ui:SliderValueBox.Slider="{Binding ElementName=StandbySpeedSlider}" Text="3000"/>
                            </Grid>
                        </StackPanel>
                    </ctrl:SectionCard>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
