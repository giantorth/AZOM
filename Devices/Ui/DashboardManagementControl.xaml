<UserControl x:Class="MozaPlugin.Devices.Ui.DashboardManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:MozaControls"
             xmlns:res="clr-namespace:MozaPlugin.Resources"
             xmlns:ui="clr-namespace:MozaPlugin.UI"
             Padding="0"
             TextElement.Foreground="{DynamicResource TextBrush}"
             TextElement.FontFamily="{DynamicResource FontUi}"
             TextElement.FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MozaPlugin;component/Themes/MozaTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MozaPlugin;component/Themes/MozaIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- WPF built-in bool → Visibility converter; used by the inline
                 channel-mapping editor to show/hide its panel based on row.IsEditing. -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

            <Style x:Key="SliderLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
                <Setter Property="Width" Value="110"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="DashListItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                    CornerRadius="3" SnapsToDevicePixels="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgCardHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ToggleOnBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PagerButton" TargetType="Button" BasedOn="{StaticResource MozaButtonGhost}">
                <Setter Property="Padding" Value="6,10"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="PagerChevron" TargetType="Path">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Style>
            <Style x:Key="SliderValue" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
            </Style>
            <Style x:Key="SettingSlider" TargetType="Slider" BasedOn="{StaticResource MozaSlider}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="MinWidth" Value="80"/>
                <Setter Property="IsSnapToTickEnabled" Value="True"/>
            </Style>

            <!-- Default styles for native WPF controls — picks up the new aesthetic -->
            <Style TargetType="Button" BasedOn="{StaticResource MozaButton}"/>
            <Style TargetType="CheckBox" BasedOn="{StaticResource MozaCheckBox}"/>
            <Style TargetType="ComboBox" BasedOn="{StaticResource MozaCombo}"/>
            <Style TargetType="Slider" BasedOn="{StaticResource MozaSlider}"/>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
            <Style TargetType="Separator">
                <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
                <Setter Property="Height" Value="1"/>
            </Style>
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="VerticalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="RowBackground" Value="{StaticResource BgCardBrush}"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource BgCard2Brush}"/>
            </Style>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource BgCard2Brush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <!-- ==================== DASHBOARD ==================== -->
        <!-- One card: preview (left) + dashboard list (right), then telemetry (left)
             and display (right) settings. Test pattern sits in the header. -->
        <ctrl:SectionCard x:Name="DashboardTelemetryCard"
                          Title="{x:Static res:Strings.Section_DashboardTelemetry}"
                          Icon="{StaticResource IconBolt}" Margin="0,0,0,14">
            <ctrl:SectionCard.Header>
                <Button x:Name="TelemetryTestBtn" Padding="10,2" Click="TelemetryTestToggle_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="TelemetryTestIcon" Data="{StaticResource IconPlay}" Stretch="Uniform"
                              Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock x:Name="TelemetryTestText" Text="{x:Static res:Strings.Button_SendTestPattern}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ctrl:SectionCard.Header>
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Studio-rendered preview of the selected dashboard. Hidden when Studio
                         isn't installed or the surface has no mzdash (FSR1/CM1). -->
                    <Grid x:Name="DashboardPreviewPanel" Grid.Column="0" Margin="0,0,14,0"
                          VerticalAlignment="Center" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DashboardPreviewPrevBtn" Grid.Column="0" Style="{StaticResource PagerButton}"
                                Margin="0,0,6,0" Click="DashboardPreviewPrev_Click">
                            <Path Data="{StaticResource IconChevronLeft}" Style="{StaticResource PagerChevron}"/>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <Grid>
                                <Image x:Name="DashboardPreviewImage" Stretch="Uniform" StretchDirection="DownOnly"
                                       MaxHeight="130" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <!-- Stand-in sized like a typical render (975×310 at 130 high)
                                     while rendering or when no preview can be made. -->
                                <Grid x:Name="DashboardPreviewPlaceholder" Width="410" Height="130" Visibility="Collapsed">
                                    <Rectangle Stroke="{DynamicResource BorderBrightBrush}" StrokeThickness="1"
                                               StrokeDashArray="4 3" RadiusX="4" RadiusY="4"/>
                                    <TextBlock x:Name="DashboardPreviewStatus" Style="{StaticResource MutedHintText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="DashboardPreviewPageLabel" HorizontalAlignment="Center" Margin="0,4,0,0"
                                       FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextDimBrush}"/>
                        </StackPanel>
                        <Button x:Name="DashboardPreviewNextBtn" Grid.Column="2" Style="{StaticResource PagerButton}"
                                Margin="6,0,0,0" Click="DashboardPreviewNext_Click">
                            <Path Data="{StaticResource IconChevronRight}" Style="{StaticResource PagerChevron}"/>
                        </Button>
                    </Grid>

                    <ListBox x:Name="TelemetryProfileList" Grid.Column="1" Height="160"
                             ItemContainerStyle="{StaticResource DashListItem}"
                             Background="{DynamicResource BgDeepBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionMode="Single"
                             SelectionChanged="TelemetryProfileList_SelectionChanged"/>
                </Grid>

                <Separator Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Telemetry -->
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="{x:Static res:Strings.Label_EnableDashboardTelemetry}" Style="{StaticResource SliderLabel}"/>
                            <ctrl:OffOnToggle x:Name="TelemetryEnabledCheck" VerticalAlignment="Center"
                                              Click="TelemetryEnabledCheck_Click"/>
                        </StackPanel>
                        <!-- Wheel page only: RPM LED pulse during catalog negotiation. -->
                        <StackPanel x:Name="SyncStatusLedPanel" Orientation="Horizontal" Margin="0,4" Visibility="Collapsed">
                            <TextBlock Text="{x:Static res:Strings.SliderLabel_SyncStatusLed}" Style="{StaticResource SliderLabel}"/>
                            <ctrl:OffOnToggle x:Name="SyncStatusLedToggle" VerticalAlignment="Center"
                                              Click="SyncStatusLedToggle_Click"/>
                            <Border x:Name="SyncStatusLedSwatch" Width="24" Height="24" Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    BorderBrush="{StaticResource BorderBrightBrush}" BorderThickness="1"
                                    CornerRadius="12" Background="Blue" Cursor="Hand"
                                    MouseLeftButtonUp="SyncStatusLedSwatch_Click"/>
                        </StackPanel>
                        <!-- FSR1-only byte probe. -->
                        <WrapPanel Orientation="Horizontal" Margin="0,4">
                            <Button x:Name="Fsr1ProbeBtn" Content="Probe bytes" Visibility="Collapsed"
                                    Margin="0,0,8,0" Click="Fsr1ProbeToggle_Click"/>
                            <Button x:Name="Fsr1ProbePrevBtn" Content="◀" Visibility="Collapsed" Width="30"
                                    Margin="0,0,4,0" Click="Fsr1ProbePrev_Click"/>
                            <Button x:Name="Fsr1ProbeNextBtn" Content="▶" Visibility="Collapsed" Width="30"
                                    Margin="0,0,8,0" Click="Fsr1ProbeNext_Click"/>
                            <TextBlock x:Name="Fsr1ProbeLabel" Visibility="Collapsed" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{StaticResource BorderBrush}"/>

                    <!-- Display -->
                    <StackPanel Grid.Column="2" Margin="14,0,0,0">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Brightness}" Style="{StaticResource SliderLabel}"/>
                            <Slider Grid.Column="1" x:Name="WheelDisplayBrightnessSlider" Style="{StaticResource SettingSlider}"
                                    Minimum="0" Maximum="100" TickFrequency="1"
                                    ValueChanged="WheelDisplayBrightnessSlider_ValueChanged"/>
                            <TextBox Grid.Column="2" x:Name="WheelDisplayBrightnessValue" Style="{StaticResource SliderValueEditBox}" ui:SliderValueBox.Slider="{Binding ElementName=WheelDisplayBrightnessSlider}" Text="100"/>
                        </Grid>
                        <StackPanel x:Name="WheelDisplayRotationPanel" Orientation="Horizontal" Margin="0,4" Visibility="Collapsed">
                            <TextBlock Text="{x:Static res:Strings.SliderLabel_DisplayRotation}" Style="{StaticResource SliderLabel}"/>
                            <ComboBox x:Name="WheelDisplayRotationCombo" Width="140"
                                      SelectionChanged="WheelDisplayRotationCombo_Changed">
                                <ComboBoxItem Tag="0" Content="{x:Static res:Strings.Option_Off}"/>
                                <ComboBoxItem Tag="1" Content="{x:Static res:Strings.Option_RotationSmooth}"/>
                                <ComboBoxItem Tag="2" Content="{x:Static res:Strings.Option_RotationImmediate}"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="{x:Static res:Strings.SliderLabel_StandbyTime}" Style="{StaticResource SliderLabel}"/>
                            <ComboBox x:Name="WheelDisplayStandbyCombo" Width="140"
                                      SelectionChanged="WheelDisplayStandbyCombo_Changed">
                                <ComboBoxItem Tag="1" Content="{x:Static res:Strings.Option_Time1Min}"/>
                                <ComboBoxItem Tag="2" Content="{x:Static res:Strings.Option_Time2Min}"/>
                                <ComboBoxItem Tag="3" Content="{x:Static res:Strings.Option_Time3Min}"/>
                                <ComboBoxItem Tag="4" Content="{x:Static res:Strings.Option_Time4Min}"/>
                                <ComboBoxItem Tag="5" Content="{x:Static res:Strings.Option_Time5Min}"/>
                                <ComboBoxItem Tag="10" Content="{x:Static res:Strings.Option_Time10Min}"/>
                                <ComboBoxItem Tag="15" Content="{x:Static res:Strings.Option_Time15Min}"/>
                                <ComboBoxItem Tag="20" Content="{x:Static res:Strings.Option_Time20Min}"/>
                                <ComboBoxItem Tag="25" Content="{x:Static res:Strings.Option_Time25Min}"/>
                                <ComboBoxItem Tag="30" Content="{x:Static res:Strings.Option_Time30Min}"/>
                                <ComboBoxItem Tag="35" Content="{x:Static res:Strings.Option_Time35Min}"/>
                                <ComboBoxItem Tag="40" Content="{x:Static res:Strings.Option_Time40Min}"/>
                                <ComboBoxItem Tag="45" Content="{x:Static res:Strings.Option_Time45Min}"/>
                                <ComboBoxItem Tag="60" Content="{x:Static res:Strings.Option_Time1Hour}"/>
                                <ComboBoxItem Tag="120" Content="{x:Static res:Strings.Option_Time2Hour}"/>
                                <ComboBoxItem Tag="180" Content="{x:Static res:Strings.Option_Time3Hour}"/>
                                <ComboBoxItem Tag="240" Content="{x:Static res:Strings.Option_Time4Hour}"/>
                                <ComboBoxItem Tag="300" Content="{x:Static res:Strings.Option_Time5Hour}"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ctrl:SectionCard>

        <ctrl:SectionCard Title="{x:Static res:Strings.Section_ChannelMappings}"
                          Icon="{StaticResource IconDiag}">
            <!-- Header-right slot (HeaderedContentControl.Header): opens the master
                 channel mapper, which edits the active profile's per-game Telemetry.json
                 defaults that the per-dashboard list below overrides. Hidden on FSR1/CM1 surfaces —
                 their field defaults come from their own catalogs, not Telemetry.json. -->
            <ctrl:SectionCard.Header>
                <Button x:Name="MasterMapperButton" Padding="10,2"
                        Content="{x:Static res:Strings.Button_MasterChannelDefaults}"
                        Click="MasterChannelMapper_Click"/>
            </ctrl:SectionCard.Header>
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Hint_ClickPencilForProperty}"
                           Style="{StaticResource MutedHintText}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <!-- Loading state: shown while ChannelMappingRowFactory.Build returns
                     null (no profile + no wheel catalog yet). Code-behind toggles
                     Visibility from PopulateChannelMappingList. -->
                <TextBlock x:Name="TelemetryChannelListLoading"
                           Text="{x:Static res:Strings.Status_LoadingChannelMappings}"
                           Style="{StaticResource MutedHintText}"
                           FontStyle="Italic"
                           Margin="0,4,0,10"
                           Visibility="Visible"/>

                <!-- Static three-column header (30 / 40 / 30). Mirrors the row
                     template's column proportions so values line up. -->
                <Grid x:Name="TelemetryChannelListHeader" Margin="0,0,0,4" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.DataGridHeader_Channel}"
                               Style="{StaticResource MutedHintText}"
                               FontWeight="SemiBold" Padding="10,4"/>
                    <TextBlock Grid.Column="1" Text="{x:Static res:Strings.DataGridHeader_SimHubProperty}"
                               Style="{StaticResource MutedHintText}"
                               FontWeight="SemiBold" Padding="10,4"/>
                    <TextBlock Grid.Column="2" Text="{x:Static res:Strings.DataGridHeader_CurrentValue}"
                               Style="{StaticResource MutedHintText}"
                               FontWeight="SemiBold" TextAlignment="Right" Padding="10,4"/>
                </Grid>

                <!-- Static list (no DataGrid) — one row per channel mapping. Each
                     row's middle column shows the bound SimHub property as plain
                     text + a pencil icon that toggles the row's inline editor. -->
                <ItemsControl x:Name="TelemetryChannelList" Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- Row -->
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="4*"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Padding="10,4"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <!-- SimHub property/formula cell: the current mapping
                                         text + a pencil (simple: pick a property) + a ƒₓ
                                         button (advanced: SimHub's [property] NCalc / js:
                                         formula editor). -->
                                    <Grid Grid.Column="1" Margin="10,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding SimHubProperty}"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource FontMono}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1"
                                                Click="EditMapping_Click"
                                                Tag="{Binding}"
                                                ToolTip="{x:Static res:Strings.Tooltip_EditMapping}"
                                                Width="26" Height="22"
                                                Padding="2"
                                                Margin="6,0,0,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand">
                                            <Path Data="{StaticResource IconEdit}"
                                                  Stretch="Uniform"
                                                  Width="14" Height="14"
                                                  Stroke="{DynamicResource TextDimBrush}"
                                                  StrokeThickness="1.5"
                                                  Fill="{x:Null}"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                        </Button>
                                        <Button Grid.Column="2"
                                                Click="AdvancedEditMapping_Click"
                                                Tag="{Binding}"
                                                ToolTip="{x:Static res:Strings.Tooltip_EditFormula}"
                                                Width="34" Height="22"
                                                Padding="2"
                                                Margin="4,0,0,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand">
                                            <TextBlock Text="𝑓(𝑥)"
                                                       FontFamily="Cambria Math, Segoe UI"
                                                       FontSize="14"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextDimBrush}"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding CurrentValueText}"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               Padding="10,4"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontFamily="{DynamicResource FontMono}"/>
                                </Grid>

                                <!-- Inline simple editor — visible when row.IsEditing.
                                     Filter TextBox + virtualized property ListBox + Cancel/OK,
                                     plus the FSR1/CM1 per-field steppers below. -->
                                <Border Margin="20,4,20,8"
                                        Background="{DynamicResource BgCard2Brush}"
                                        BorderBrush="{DynamicResource BorderBrightBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        Visibility="{Binding IsEditing,
                                                    Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     x:Name="EditFilterBox"
                                                     Text="{Binding EditFilter,
                                                           UpdateSourceTrigger=PropertyChanged,
                                                           Mode=TwoWay}"
                                                     FontFamily="{DynamicResource FontMono}"
                                                     Padding="8,4"
                                                     Foreground="{DynamicResource TextBrush}"
                                                     Background="{DynamicResource BgDeepBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}"
                                                     BorderThickness="1"/>
                                            <Button Grid.Column="1"
                                                    Content="{x:Static res:Strings.Button_Cancel}"
                                                    Margin="6,0,0,0"
                                                    Click="CancelMapping_Click"
                                                    Tag="{Binding}"/>
                                            <Button Grid.Column="2"
                                                    Content="{x:Static res:Strings.Button_Ok}"
                                                    MinWidth="60"
                                                    Margin="6,0,0,0"
                                                    Click="CommitMapping_Click"
                                                    Tag="{Binding}"/>
                                        </Grid>
                                        <ListBox ItemsSource="{Binding FilteredProperties}"
                                                 SelectedItem="{Binding PendingProperty, Mode=TwoWay}"
                                                 MaxHeight="240"
                                                 Background="{DynamicResource BgDeepBrush}"
                                                 Foreground="{DynamicResource TextBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 BorderThickness="1"
                                                 VirtualizingStackPanel.IsVirtualizing="True"
                                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               FontFamily="{DynamicResource FontMono}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               Padding="6,3"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- FSR V1 only: per-field input scaling. The
                                             source value between Min and Max maps onto the
                                             field's full-scale output (CapabilityText). -->
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                    Visibility="{Binding IsFsr1,
                                                                Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Input min" VerticalAlignment="Center"
                                                       Style="{StaticResource MutedHintText}"/>
                                            <TextBox Text="{Binding InMin, Mode=TwoWay,
                                                           UpdateSourceTrigger=LostFocus}"
                                                     Width="70" Margin="6,0,0,0" Padding="6,3"
                                                     Foreground="{DynamicResource TextBrush}"
                                                     Background="{DynamicResource BgDeepBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}"
                                                     BorderThickness="1"/>
                                            <TextBlock Text="Input max" VerticalAlignment="Center"
                                                       Margin="12,0,0,0"
                                                       Style="{StaticResource MutedHintText}"/>
                                            <TextBox Text="{Binding InMax, Mode=TwoWay,
                                                           UpdateSourceTrigger=LostFocus}"
                                                     Width="70" Margin="6,0,0,0" Padding="6,3"
                                                     Foreground="{DynamicResource TextBrush}"
                                                     Background="{DynamicResource BgDeepBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}"
                                                     BorderThickness="1"/>
                                            <TextBlock Text="{Binding CapabilityText, StringFormat='→ {0}'}"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                                       FontFamily="{DynamicResource FontMono}"
                                                       Foreground="{DynamicResource TextDimBrush}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                    Visibility="{Binding IsFsr1,
                                                                Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{x:Static res:Strings.Edit_Scale}"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource MutedHintText}"/>
                                            <TextBox Text="{Binding Scale, Mode=TwoWay,
                                                           UpdateSourceTrigger=LostFocus}"
                                                     Width="70" Margin="6,0,0,0" Padding="6,3"
                                                     Foreground="{DynamicResource TextBrush}"
                                                     Background="{DynamicResource BgDeepBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}"
                                                     BorderThickness="1"/>
                                            <TextBlock Text="{x:Static res:Strings.Edit_Bias}"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                                       Style="{StaticResource MutedHintText}"/>
                                            <TextBox Text="{Binding Bias, Mode=TwoWay,
                                                           UpdateSourceTrigger=LostFocus}"
                                                     Width="70" Margin="6,0,0,0" Padding="6,3"
                                                     Foreground="{DynamicResource TextBrush}"
                                                     Background="{DynamicResource BgDeepBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}"
                                                     BorderThickness="1"/>
                                            <Button Content="{x:Static res:Strings.Button_ResetField}"
                                                    Margin="14,0,0,0"
                                                    Click="FieldReset_Click" Tag="{Binding}"/>
                                        </StackPanel>

                                        <!-- CM1 only: per-field gain. CM1 is always BE float32,
                                             so only Scale applies (no boundary/endianness). -->
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                    Visibility="{Binding IsCm1,
                                                                Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{x:Static res:Strings.Edit_Scale}"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource MutedHintText}"/>
                                            <TextBox Text="{Binding Scale, Mode=TwoWay,
                                                           UpdateSourceTrigger=LostFocus}"
                                                     Width="70" Margin="6,0,0,0" Padding="6,3"
                                                     Foreground="{DynamicResource TextBrush}"
                                                     Background="{DynamicResource BgDeepBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}"
                                                     BorderThickness="1"/>
                                            <Button Content="{x:Static res:Strings.Button_ResetField}"
                                                    Margin="14,0,0,0"
                                                    Click="FieldReset_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- FSR V1 only: live numeric byte-strip visualization. One record per
                     active dashboard; each field's data-byte span is boxed and labelled
                     with the raw bytes (hex) AND the post-scale/transform value. Refreshed
                     ~2 Hz from the live driver output via GetFsr1VizSnapshot(). The whole
                     block is hidden when the snapshot is empty (non-FSR1 wheels). -->
                <StackPanel x:Name="Fsr1VizPanel" Margin="0,0,0,10" Visibility="Collapsed">
                <TextBlock Text="{x:Static res:Strings.Viz_Title}"
                           Style="{StaticResource MutedHintText}"
                           FontWeight="SemiBold" Margin="0,4,0,6"/>
                <ItemsControl x:Name="Fsr1VizList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Background="{DynamicResource BgCard2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <!-- Field boxes laid out left→right in Start order. Each box
                                         shows the field label, the raw bytes (hex) and the scaled
                                         value. A synthetic split box is tinted to stand out. -->
                                    <ItemsControl ItemsSource="{Binding Fields}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,6,6"
                                                        MinWidth="74"
                                                        Background="{Binding BoxBrush}"
                                                        BorderBrush="{DynamicResource BorderBrightBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="6,4">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}"
                                                                   Foreground="{DynamicResource TextDimBrush}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="140"/>
                                                        <TextBlock Text="{Binding RangeText}"
                                                                   Foreground="{DynamicResource TextDimBrush}"
                                                                   FontFamily="{DynamicResource FontMono}"
                                                                   FontSize="10"/>
                                                        <TextBlock Text="{Binding HexText}"
                                                                   Foreground="{DynamicResource AmberBrush}"
                                                                   FontFamily="{DynamicResource FontMono}"
                                                                   FontSize="12"/>
                                                        <TextBlock Text="{Binding ValueText}"
                                                                   Foreground="{DynamicResource CyanBrush}"
                                                                   FontFamily="{DynamicResource FontMono}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static res:Strings.Button_ResetToDefaults}" Click="TelemetryResetMappings_Click"/>
                    <TextBlock x:Name="TelemetryMappingStatus"
                               Style="{StaticResource MutedHintText}"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </ctrl:SectionCard>

    </StackPanel>
</UserControl>
