<UserControl x:Class="MozaPlugin.Devices.Ui.MozaBaseSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:MozaControls"
             xmlns:res="clr-namespace:MozaPlugin.Resources"
             xmlns:ui="clr-namespace:MozaPlugin.UI"
             Padding="14"
             TextElement.Foreground="{DynamicResource TextBrush}"
             TextElement.FontFamily="{DynamicResource FontUi}"
             TextElement.FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MozaPlugin;component/Themes/MozaTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MozaPlugin;component/Themes/MozaIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleText}">
                <Setter Property="Margin" Value="0,20,0,8"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
                <Setter Property="Width" Value="180"/>
            </Style>
            <Style x:Key="SliderValue" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
            </Style>
            <Style x:Key="SettingSlider" TargetType="Slider" BasedOn="{StaticResource MozaSlider}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="MinWidth" Value="80"/>
                <Setter Property="IsSnapToTickEnabled" Value="True"/>
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource MozaButton}"/>
            <Style TargetType="CheckBox" BasedOn="{StaticResource MozaCheckBox}"/>
            <Style TargetType="Slider" BasedOn="{StaticResource MozaSlider}"/>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
            <Style TargetType="Separator">
                <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
                <Setter Property="Height" Value="1"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- ScrollViewer removed: SimHub host already provides scrolling -->
        <StackPanel>

            <!-- Shared plugin status banners (port-locked, restart-required,
                 profile-not-added, telemetry parked/degraded) — surfaced here so
                 users who only visit the device page still see them. -->
            <ui:PluginBanners/>

            <!-- Detection status -->
            <StackPanel x:Name="BaseAmbientNotDetectedPanel">
                <TextBlock Text="{x:Static res:Strings.Hint_NoBaseAmbientDetected}"
                           Style="{StaticResource MutedHintText}" FontStyle="Italic" Margin="0,10" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel x:Name="BasePanel" Visibility="Collapsed">

                <!-- Mode + brightness side by side: both are single-control cards.
                     Same two-column pattern as SettingsControl's Core Settings /
                     Gearshift pair — equal * columns, 7px inner gutter each side,
                     14px bottom margin so the next card does not touch. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ctrl:SectionCard Grid.Column="0" Title="{x:Static res:Strings.Section_Mode}"
                                      Icon="{StaticResource IconBolt}" Margin="0,0,7,14">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="{x:Static res:Strings.SliderLabel_IndicatorState}" Style="{StaticResource FieldLabel}"/>
                            <ctrl:SegmentedControl x:Name="IndicatorStateCombo" SelectionChanged="IndicatorStateCombo_Changed">
                                <ListBoxItem Content="{x:Static res:Strings.Option_Off}"/>
                                <ListBoxItem Content="{x:Static res:Strings.Option_SimHubMode}"/>
                                <ListBoxItem Content="{x:Static res:Strings.Option_On}"/>
                            </ctrl:SegmentedControl>
                        </StackPanel>
                    </ctrl:SectionCard>

                    <ctrl:SectionCard Grid.Column="1" Title="{x:Static res:Strings.Section_Brightness}"
                                      Icon="{StaticResource IconLed}" Margin="7,0,0,14">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Brightness}" Style="{StaticResource FieldLabel}"/>
                            <Slider Grid.Column="1" x:Name="BrightnessSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="BrightnessSlider_ValueChanged"/>
                            <TextBox Grid.Column="2" x:Name="BrightnessValue" Style="{StaticResource SliderValueEditBox}" ui:SliderValueBox.Slider="{Binding ElementName=BrightnessSlider}" Text="100"/>
                        </Grid>
                    </ctrl:SectionCard>
                </Grid>

                <!-- Idle effect: the animation selector, its speed (1E [mode])
                     and that mode's per-LED palette. Speed hides for off and
                     constant (no interval register); the palette hides for
                     off/cycle/rainbow/flow (no stored palette). -->
                <ctrl:SectionCard Title="{x:Static res:Strings.Section_IdleEffect}" Icon="{StaticResource IconLed}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="{x:Static res:Strings.SliderLabel_IdleAnimation}" Style="{StaticResource FieldLabel}"/>
                            <ctrl:SegmentedControl x:Name="StandbyModeCombo" SelectionChanged="StandbyModeCombo_Changed">
                                <ListBoxItem Content="{x:Static res:Strings.Option_Off}"/>
                                <ListBoxItem Content="{x:Static res:Strings.Option_Constant}"/>
                                <ListBoxItem Content="{x:Static res:Strings.Option_Breath}"/>
                                <ListBoxItem Content="{x:Static res:Strings.Option_Cycle}"/>
                                <ListBoxItem Content="{x:Static res:Strings.Option_Rainbow}"/>
                                <ListBoxItem Content="{x:Static res:Strings.Option_Flow}"/>
                            </ctrl:SegmentedControl>
                        </StackPanel>
                        <Grid x:Name="StandbySpeedRow" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_StandbySpeedMs}" Style="{StaticResource FieldLabel}"/>
                            <Slider Grid.Column="1" x:Name="StandbySpeedSlider" Style="{StaticResource SettingSlider}" Minimum="100" Maximum="10000" TickFrequency="1" ValueChanged="StandbySpeedSlider_ValueChanged"/>
                            <TextBox Grid.Column="2" x:Name="StandbySpeedValue" Style="{StaticResource SliderValueEditBox}" ui:SliderValueBox.Slider="{Binding ElementName=StandbySpeedSlider}" Text="2500"/>
                        </Grid>
                        <StackPanel x:Name="IdleLedPanel" Margin="0,4,0,0"/>
                    </StackPanel>
                </ctrl:SectionCard>

                <ctrl:SectionCard Title="{x:Static res:Strings.Section_Sleep}" Icon="{StaticResource IconMisc}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="{x:Static res:Strings.SliderLabel_SleepMode}" Style="{StaticResource FieldLabel}"/>
                            <!-- Effect selector, not an enable: 0 = disabled, 1 = breathe. -->
                            <ctrl:SegmentedControl x:Name="SleepModeCombo" SelectionChanged="SleepModeCombo_Changed">
                                <ListBoxItem Content="{x:Static res:Strings.Option_Disabled}"/>
                                <ListBoxItem Content="{x:Static res:Strings.Option_Breath}"/>
                            </ctrl:SegmentedControl>
                        </StackPanel>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_SleepTimeout}" Style="{StaticResource FieldLabel}"/>
                            <Slider Grid.Column="1" x:Name="SleepTimeoutSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="300" TickFrequency="1" ValueChanged="SleepTimeoutSlider_ValueChanged"/>
                            <TextBox Grid.Column="2" x:Name="SleepTimeoutValue" Style="{StaticResource SliderValueEditBox}" ui:SliderValueBox.Slider="{Binding ElementName=SleepTimeoutSlider}" Text="15"/>
                        </Grid>
                        <!-- Sleep breathing speed (0x23 [sleep-mode]) — only
                             meaningful while the sleep effect is breathing. -->
                        <Grid x:Name="SleepSpeedRow" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_SleepSpeedMs}" Style="{StaticResource FieldLabel}"/>
                            <Slider Grid.Column="1" x:Name="SleepSpeedSlider" Style="{StaticResource SettingSlider}" Minimum="100" Maximum="10000" TickFrequency="1" ValueChanged="SleepSpeedSlider_ValueChanged"/>
                            <TextBox Grid.Column="2" x:Name="SleepSpeedValue" Style="{StaticResource SliderValueEditBox}" ui:SliderValueBox.Slider="{Binding ElementName=SleepSpeedSlider}" Text="2500"/>
                        </Grid>
                        <!-- Sleep palette (25 [strip] 01 [led]) — only while the
                             sleep effect is breathing. -->
                        <StackPanel x:Name="SleepLedPanel" Margin="0,4,0,0"/>
                    </StackPanel>
                </ctrl:SectionCard>

            </StackPanel>
        </StackPanel>
    <!-- /ScrollViewer -->
</UserControl>
