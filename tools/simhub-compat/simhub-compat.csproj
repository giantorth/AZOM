<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>simhub-compat</AssemblyName>
    <RootNamespace>SimHubCompat</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Standalone dev tool: never part of the plugin build or the sln. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.Metadata" Version="9.0.0" />
  </ItemGroup>

</Project>
