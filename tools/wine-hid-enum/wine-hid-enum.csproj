<Project Sdk="Microsoft.NET.Sdk">

  <!-- Run under a Wine prefix to see what HidSharp (SimHub's copy) makes of
       each HID device: enumeration, report descriptor, open, live reports.
       Standalone dev tool: never part of the plugin build or the sln. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>wine-hid-enum</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The plugin's own decoder, so this exercises the shipped code. -->
    <Compile Include="..\..\Protocol\HidInputLayout.cs" Link="HidInputLayout.cs" />
    <Reference Include="HidSharp">
      <HintPath>..\..\libs\SimHub\HidSharp.dll</HintPath>
    </Reference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
