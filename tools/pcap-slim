#!/usr/bin/env python3
"""Write a slim pcapng containing only the packets of one USB device address.

The MOZA motion-platform race captures are 3-16 GB because USB ethernet
adapters share the host controller; the motion controller's own traffic is a
few MB. Slim first, then run tools/pcap-inventory and tools/motion-decode on
the small file.

Usage:
    tools/pcap-slim <in.pcapng> <out.pcapng> --device 5

Find the device address with `tools/pcap-inventory <in.pcapng> --device auto`.
SHB/IDB blocks are copied verbatim so timestamps keep their epoch base.
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
from usbpcap import BLOCK_EPB, BLOCK_IDB, BLOCK_SHB, epb_fields, iter_blocks, parse_usbpcap  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("src")
    ap.add_argument("dst")
    ap.add_argument("--device", type=int, required=True, help="USBPcap device address to keep")
    args = ap.parse_args()

    kept = total = 0
    with open(args.dst, "wb", buffering=8 * 1024 * 1024) as out:
        for btype, block in iter_blocks(args.src):
            if btype in (BLOCK_SHB, BLOCK_IDB):
                out.write(block)
                continue
            if btype != BLOCK_EPB:
                continue
            total += 1
            _, pkt = epb_fields(block)
            parsed = parse_usbpcap(pkt, 0.0)
            if parsed is None or parsed.device != args.device:
                continue
            out.write(block)
            kept += 1
    print(f"{args.src}: kept {kept} of {total} packets (device {args.device}) -> {args.dst}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
