                                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_ShiftDebounce}" Style="{StaticResource LfeLabel}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" x:Name="S12RoadDebounceValue" Width="58" Margin="0,0,38,0" Style="{StaticResource SliderValueEditBox}" Tag="{Binding ElementName=S12RoadDebounceSlider}" KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"/>
                                        </Grid>
                                        <Slider x:Name="S12RoadDebounceSlider" Tag="road" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="1000" TickFrequency="50" SmallChange="50" LargeChange="50" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="S12Debounce_ValueChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </ctrl:SectionCard>
                        </Grid>
                        <!-- S12-GEN-END -->
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== mBOOSTER TAB ==================== -->
            <TabItem x:Name="MBoosterTab" Header="{x:Static res:Strings.TabHeader_MBooster}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Pinned pedal trace — shows every connected pedal's live
                         position (Brake/Throttle/Clutch), independent of device
                         selection, so it stays visible while the rest of the
                         tab scrolls underneath it. -->
                    <ctrl:SectionCard Grid.Row="0" Title="{x:Static res:Strings.Section_MBoosterPedals}"
                                      Subtitle="{x:Static res:Strings.Subtitle_MBoosterPedals}"
                                      Icon="{StaticResource IconPedals}" Margin="22,18,22,0">
                        <StackPanel>
                            <ctrl:BandwidthSparkline x:Name="MBoosterPedalTraceViz" Height="70"
                                                      InBrush="{StaticResource RedBrush}"
                                                      InFillBrush="{StaticResource McuFillBrush}"
                                                      OutBrush="{StaticResource GreenBrush}"
                                                      OutFillBrush="{StaticResource MotorFillBrush}"
                                                      ThirdBrush="{StaticResource BlueBrush}"
                                                      ThirdFillBrush="{StaticResource BwThirdFillBrush}"
                                                      MaxValue="100"
                                                      ShowGridlines="True"/>

                            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedHintText}" Margin="0,12,0,12" Text="{x:Static res:Strings.Hint_MBoosterIntro}"/>

                            <!-- One row per connected PEDAL (HID axis) — a chained mBooster
                                 hosting several pedals on one connection gets one row per axis,
                                 not one row for the whole connection. The label is a plain
                                 clickable Button (see MBoosterDeviceRowButtonStyle); clicking a
                                 row selects BOTH the physical device AND that specific pedal for
                                 the Pedal Feel/Sim Input/Effects cards below,
                                 replacing the old trio of Device combo + per-axis Pedal Roles
                                 panel + Configure-pedal combo. Each row's own Role combo edits
                                 THAT pedal's Role regardless of which row is selected; two
                                 pedals may share a role, as Pit House allows. -->
                            <ItemsControl x:Name="MBoosterDeviceRowsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource MBoosterDeviceRowButtonStyle}"
                                                    Content="{Binding Label}" HorizontalAlignment="Left"
                                                    Click="MBoosterDeviceRow_Click"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static res:Strings.SliderLabel_Role}" Style="{StaticResource LabelText}"
                                                       VerticalAlignment="Center" Margin="16,0,10,0"/>
                                            <ComboBox Grid.Row="0" Grid.Column="2" SelectedIndex="{Binding RoleIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="{x:Static res:Strings.Option_Disabled}"/>
                                                <ComboBoxItem Content="{x:Static res:Strings.Option_Throttle}"/>
                                                <ComboBoxItem Content="{x:Static res:Strings.Option_Brake}"/>
                                                <ComboBoxItem Content="{x:Static res:Strings.Option_Clutch}"/>
                                            </ComboBox>
                                            <!-- Per-pedal hardware calibration routines. On this row so
                                                 there is no doubt which pedal they act on: a unit hosting
                                                 two ACTIVE pedals answers both on one device id, so one
                                                 shared pair could not say (bug GVT5H8B8). Hidden for a
                                                 passive pedal, which has no motor to sweep or locate.
                                                 Enable/caption pushed by RefreshMBoosterCalUi. -->
                                            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="16,0,0,0"
                                                        Visibility="{Binding CalVisible, Converter={StaticResource BoolToVisibility}}">
                                                <Button Content="{Binding TravelCalLabel}" IsEnabled="{Binding TravelCalEnabled}"
                                                        Margin="0,0,6,0" Click="MBoosterRowTravelCal_Click"/>
                                                <Button Content="{Binding MotorCalLabel}" IsEnabled="{Binding MotorCalEnabled}"
                                                        Click="MBoosterRowMotorCal_Click"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                                       Text="{Binding CalStatus}" Style="{StaticResource MutedHintText}"
                                                       TextWrapping="Wrap" Margin="0,4,0,2"
                                                       Visibility="{Binding CalStatus, Converter={StaticResource EmptyStringToVisibility}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ctrl:SectionCard>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18,22,8">
                    <StackPanel>

                        <!-- Per-device panel: wraps Pedal Feel + Sim Input Mapping + Effects + Calibration into nested cards -->
                        <StackPanel x:Name="MBoosterDevicePanel" Visibility="Collapsed">

                            <ctrl:SectionCard Title="{x:Static res:Strings.Section_PedalFeelSimInput}"
                                              Icon="{StaticResource IconCurve}"
                                              IsCollapsible="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left half: Pedal Feel -->
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="{x:Static res:Strings.Section_PedalFeel}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>

                                        <!-- Deadzone, Max Force, and the Pedal Feel curve are ALL a
                                             brake-named singleton hardware write (cmdId 0xAB selectors
                                             0x07-0x0E) — same passive-pedal gating as Travel/End Stop,
                                             since editing them from a passive pedal's page would
                                             overwrite the active pedal's registers instead. Placed first
                                             in this card so the curve (the primary control) is
                                             immediately visible without scrolling. -->
                                        <StackPanel x:Name="MBoosterDeadzoneMaxForcePanel">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <!-- MinWidth/MaxWidth/Margin overridden from the SliderLabel style's
                                                 defaults (MinWidth=180) — that alone was forcing this Auto column
                                                 far wider than the slider+textbox stack it holds, squeezing the
                                                 curve editor in the middle column. Wraps onto 2 lines instead. -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_DeadzoneKg}" Style="{StaticResource SliderLabel}"
                                                       MinWidth="0" MaxWidth="70" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <!-- Live "position % · kg force" readout, updated at 30 Hz in
                                                 UpdateMBoosterCurveMarkers alongside this tab's other live
                                                 displays. kg is a computed estimate (raw position % scaled by
                                                 this pedal's own Max Force, i.e. what force reads 100%
                                                 travel), not a directly-read sensor value. -->
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MBoosterPedalFeelLiveLabel" Text="{x:Static res:Strings.Label_InputForce}" Style="{StaticResource SliderLabel}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static res:Strings.SliderLabel_MaxForceKg}" Style="{StaticResource SliderLabel}"
                                                       MinWidth="0" MaxWidth="70" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <!-- Vertical Deadzone slider (Brake 0-37kg, role-scoped in
                                                 UpdateMBoosterConfigVisibilityForRole). Its value is also the
                                                 curve's own (0,0) start point — the curve plots in kg, so
                                                 raising it visibly lifts where the curve begins. -->
                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0" HorizontalAlignment="Center">
                                                <Slider x:Name="MBoosterDeadzoneSlider" Style="{StaticResource MozaSliderVertical}" Height="220"
                                                        TickFrequency="0.1" ValueChanged="MBoosterDeadzoneSlider_ValueChanged"/>
                                                <TextBox x:Name="MBoosterDeadzoneValue" Style="{StaticResource SliderValueEditBox}"
                                                         Tag="{Binding ElementName=MBoosterDeadzoneSlider}"
                                                         HorizontalAlignment="Center" Width="44" Padding="2,2" Margin="0,8,0,0"
                                                         KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                         Text="0.0"/>
                                            </StackPanel>
                                            <!-- Y axis is absolute force: 0 to this role's Max Force ceiling
                                                 (set in UpdateMBoosterConfigVisibilityForRole, since the ceiling
                                                 is 200kg for a Brake but 20kg for a Throttle/Clutch). The 6
                                                 stored nodes stay percentages of the Deadzone-Max Force span —
                                                 SpanLow/SpanHigh convert them — so the (0,0) Deadzone point and
                                                 the (100,100) Max Force point are both plotted where their
                                                 sliders put them, and dragging the Max Force point vertically
                                                 writes the slider back. -->
                                            <ctrl:MozaCurveEditor Grid.Row="1" Grid.Column="1" x:Name="MBoosterInputCurveEditor" Height="220" NodeCount="6"
                                                                  AllowHorizontalDrag="True" AnchorAtTopRight="True"
                                                                  ShowAnchorPoints="True" AnchorEndDraggableInY="True"
                                                                  SpanLow="{Binding Value, ElementName=MBoosterDeadzoneSlider, Mode=OneWay}"
                                                                  SpanHigh="{Binding Value, ElementName=MBoosterMaxForceSlider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  ClampYToAdjacentNodes="True"/>
                                            <!-- Vertical Max Force slider (Brake 24-200kg, role-scoped),
                                                 mirrored to the curve editor's right. Two-way with the curve's
                                                 top-right point: drag either. -->
                                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="6,0,0,0" HorizontalAlignment="Center">
                                                <Slider x:Name="MBoosterMaxForceSlider" Style="{StaticResource MozaSliderVertical}" Height="220"
                                                        TickFrequency="1" ValueChanged="MBoosterMaxForceSlider_ValueChanged"/>
                                                <TextBox x:Name="MBoosterMaxForceValue" Style="{StaticResource SliderValueEditBox}"
                                                         Tag="{Binding ElementName=MBoosterMaxForceSlider}"
                                                         HorizontalAlignment="Center" Width="44" Padding="2,2" Margin="0,8,0,0"
                                                         KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                         Text="200"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,20">
                                            <Button Content="{x:Static res:Strings.Button_Linear}" Margin="0,0,8,0" Click="MBoosterInputCurvePreset_Linear"/>
                                            <Button Content="{x:Static res:Strings.Button_SCurve}" Margin="0,0,8,0" Click="MBoosterInputCurvePreset_SCurve"/>
                                            <Button Content="{x:Static res:Strings.Button_Exponential}" Margin="0,0,8,0" Click="MBoosterInputCurvePreset_Exponential"/>
                                            <Button Content="{x:Static res:Strings.Button_Parabolic}" Click="MBoosterInputCurvePreset_Parabolic"/>
                                        </StackPanel>
                                        </StackPanel><!-- MBoosterDeadzoneMaxForcePanel -->

                                        <!-- Travel + End Stop are HARDWARE writes on brake-named singleton
                                             cmdIds (0x84/0x85/0xB2) with no per-pedal selector, so they only
                                             belong to the pedal that owns that hardware — hidden for a passive
                                             pedal by UpdateMBoosterEffectPassiveState. -->
                                        <StackPanel x:Name="MBoosterTravelEndstopPanel">
                                        <TextBlock Text="{x:Static res:Strings.SliderLabel_TravelRangeMm}" Style="{StaticResource SliderLabel}" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                        <ctrl:MozaRangeSlider x:Name="MBoosterTravelRangeSlider" Height="90" Margin="0,0,0,16"
                                                              AccentBrush="{StaticResource CyanBrush}"
                                                              Minimum="3.8" Maximum="49.7" MinGap="3.8"
                                                              Unit="mm" Decimals="1"
                                                              LowValue="3.8" HighValue="35.9"
                                                              RangeChanged="MBoosterTravelRangeSlider_RangeChanged"/>

                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_EndstopFrontStiffness}" Style="{StaticResource SliderLabel}"/>
                                            <Slider Grid.Column="1" x:Name="MBoosterEndstopFrontSlider" Style="{StaticResource SettingSlider}" Minimum="1" Maximum="10" TickFrequency="1" ValueChanged="MBoosterEndstopFrontSlider_ValueChanged"/>
                                            <TextBox Grid.Column="2" x:Name="MBoosterEndstopFrontValue" Style="{StaticResource SliderValueEditBox}"
                                                     Tag="{Binding ElementName=MBoosterEndstopFrontSlider}"
                                                     KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                     Text="1"/>
                                        </Grid>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_EndstopEndStiffness}" Style="{StaticResource SliderLabel}"/>
                                            <Slider Grid.Column="1" x:Name="MBoosterEndstopEndSlider" Style="{StaticResource SettingSlider}" Minimum="1" Maximum="10" TickFrequency="1" ValueChanged="MBoosterEndstopEndSlider_ValueChanged"/>
                                            <TextBox Grid.Column="2" x:Name="MBoosterEndstopEndValue" Style="{StaticResource SliderValueEditBox}"
                                                     Tag="{Binding ElementName=MBoosterEndstopEndSlider}"
                                                     KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                     Text="1"/>
                                        </Grid>
                                        </StackPanel><!-- MBoosterTravelEndstopPanel -->
                                        <!-- Natural Friction is another brake-named singleton hardware write
                                             (cmdId 0xAE) — same passive-pedal gating as Travel/End Stop. -->
                                        <Grid x:Name="MBoosterNaturalFrictionPanel" Margin="0,4" ToolTip="{x:Static res:Strings.Hint_NaturalFrictionPedalFeel}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ctrl:OffOnToggle Grid.Column="0" x:Name="MBoosterNaturalFrictionEnable" Content="{x:Static res:Strings.Label_Enable}" VerticalAlignment="Center" Margin="0,0,12,0" Checked="MBoosterNaturalFrictionEnable_Changed" Unchecked="MBoosterNaturalFrictionEnable_Changed"/>
                                            <TextBlock Grid.Column="1" Text="{x:Static res:Strings.SliderLabel_NaturalFriction}" Style="{StaticResource SliderLabel}"/>
                                            <Slider Grid.Column="2" x:Name="MBoosterNaturalFrictionSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterNaturalFrictionSlider_ValueChanged"/>
                                            <TextBox Grid.Column="3" x:Name="MBoosterNaturalFrictionValue" Style="{StaticResource SliderValueEditBox}"
                                                     Tag="{Binding ElementName=MBoosterNaturalFrictionSlider}"
                                                     KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                     Text="0"/>
                                        </Grid>
                                        <!-- Data-store sliders, driven by MBoosterInputCurveEditor -->
                                        <StackPanel Visibility="Collapsed">
                                            <Slider x:Name="MBoosterInputY1Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterInputY1Slider_ValueChanged"/>
                                            <Slider x:Name="MBoosterInputY2Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterInputY2Slider_ValueChanged"/>
                                            <Slider x:Name="MBoosterInputY3Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterInputY3Slider_ValueChanged"/>
                                            <Slider x:Name="MBoosterInputY4Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterInputY4Slider_ValueChanged"/>
                                            <Slider x:Name="MBoosterInputY5Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterInputY5Slider_ValueChanged"/>
                                            <Slider x:Name="MBoosterInputY6Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterInputY6Slider_ValueChanged"/>
                                            <Slider x:Name="MBoosterInputX1Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterInputX1Slider_ValueChanged"/>
                                            <Slider x:Name="MBoosterInputX2Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterInputX2Slider_ValueChanged"/>
                                            <Slider x:Name="MBoosterInputX3Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterInputX3Slider_ValueChanged"/>
                                            <Slider x:Name="MBoosterInputX4Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterInputX4Slider_ValueChanged"/>
                                            <Slider x:Name="MBoosterInputX5Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterInputX5Slider_ValueChanged"/>
                                            <Slider x:Name="MBoosterInputX6Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterInputX6Slider_ValueChanged"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Divider between the two halves -->
                                    <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BorderBrush}"/>

                                    <!-- Right half: Sim Input Mapping -->
                                    <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                        <TextBlock Text="{x:Static res:Strings.Section_SimInputMapping}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
                                        <!-- Invisible-but-space-reserving spacer, same style/wrap-width/margin as
                                             the Pedal Feel Deadzone/Max Force labels on the left, so THIS curve
                                             starts level with that one instead of sitting a row higher (the left
                                             curve has that labels row above it; this one otherwise wouldn't). -->
                                        <TextBlock Text="{x:Static res:Strings.SliderLabel_DeadzoneKg}" Style="{StaticResource SliderLabel}"
                                                   MinWidth="0" MaxWidth="70" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,6"
                                                   Visibility="Hidden"/>
                                        <!-- Pit House's output curve: start = range start (X only),
                                             end = range end (X and Y), y1..y4 evenly spaced between. -->
                                        <ctrl:MozaCurveEditor x:Name="MBoosterCurveEditor" Height="220" NodeCount="6"
                                                              AccentBrush="{StaticResource CyanBrush}"
                                                              AllowHorizontalDrag="True"
                                                              EndpointRangeMode="True"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,20">
                                            <Button Content="{x:Static res:Strings.Button_Linear}" Margin="0,0,8,0" Click="MBoosterCurvePreset_Linear"/>
                                            <Button Content="{x:Static res:Strings.Button_SCurve}" Margin="0,0,8,0" Click="MBoosterCurvePreset_SCurve"/>
                                            <Button Content="{x:Static res:Strings.Button_Exponential}" Margin="0,0,8,0" Click="MBoosterCurvePreset_Exponential"/>
                                            <Button Content="{x:Static res:Strings.Button_Parabolic}" Click="MBoosterCurvePreset_Parabolic"/>
                                        </StackPanel>

                                        <!-- Sensor Output Ratio + Max Threshold are load-cell / pressure-
                                             sensor settings that only a BRAKE has — hidden for throttle/
                                             clutch pedals (see UpdateMBoosterConfigVisibilityForRole). The
                                             output curve above applies to every pedal mode. -->
                                        <StackPanel x:Name="MBoosterBrakeOnlyPanel">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_SensorRatio}" Style="{StaticResource SliderLabel}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Label_AngleSensor}" Style="{StaticResource SliderRangeEndLabel}" Margin="0,0,6,0"/>
                                            <Slider Grid.Column="2" x:Name="MBoosterRatioSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterRatioSlider_ValueChanged"/>
                                            <TextBlock Grid.Column="3" Text="{x:Static res:Strings.Label_LoadCell}" Style="{StaticResource SliderRangeEndLabel}" Margin="6,0,0,0"/>
                                            <TextBox Grid.Column="4" x:Name="MBoosterRatioValue" Style="{StaticResource SliderValueEditBox}"
                                                     Tag="{Binding ElementName=MBoosterRatioSlider}"
                                                     KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                     Text="0%"/>
                                        </Grid>

                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_MaxThresholdKg}" Style="{StaticResource SliderLabel}"/>
                                            <TextBlock Grid.Column="1" Text="0" Style="{StaticResource SliderRangeEndLabel}" Margin="0,0,6,0"/>
                                            <Slider Grid.Column="2" x:Name="MBoosterMaxThresholdSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="200" TickFrequency="1" ValueChanged="MBoosterMaxThresholdSlider_ValueChanged"/>
                                            <TextBlock Grid.Column="3" Text="200" Style="{StaticResource SliderRangeEndLabel}" Margin="6,0,0,0"/>
                                            <TextBox Grid.Column="4" x:Name="MBoosterMaxThresholdValue" Style="{StaticResource SliderValueEditBox}"
                                                     Tag="{Binding ElementName=MBoosterMaxThresholdSlider}"
                                                     KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                     Text="100"/>
                                        </Grid>
                                        </StackPanel><!-- MBoosterBrakeOnlyPanel -->

                                        <!-- Data-store sliders, driven by MBoosterCurveEditor: Y1 is the
                                             start point (pinned 0), Y2..Y6 = device y1..y5, X1/X6 = Min/Max. -->
                                        <StackPanel Visibility="Collapsed">
                                            <Slider x:Name="MBoosterY1Slider" Minimum="0" Maximum="100" TickFrequency="1"/>
                                            <Slider x:Name="MBoosterY2Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterY2Slider_ValueChanged"/>
                                            <Slider x:Name="MBoosterY3Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterY3Slider_ValueChanged"/>
                                            <Slider x:Name="MBoosterY4Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterY4Slider_ValueChanged"/>
                                            <Slider x:Name="MBoosterY5Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterY5Slider_ValueChanged"/>
                                            <Slider x:Name="MBoosterY6Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterY6Slider_ValueChanged"/>
                                            <Slider x:Name="MBoosterRangeStartSlider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterRangeStartSlider_ValueChanged"/>
                                            <Slider x:Name="MBoosterRangeEndSlider" Minimum="0" Maximum="100" TickFrequency="1" Value="100" ValueChanged="MBoosterRangeEndSlider_ValueChanged"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </ctrl:SectionCard>
                            <!-- Another brake-named singleton hardware write (cmdId 0xB7) — hidden
                                 for a passive pedal, same as Travel / End Stop / Natural Friction. -->
                            <ctrl:SectionCard x:Name="MBoosterSegDampCard"
                                              Title="{x:Static res:Strings.Section_PedalDamping}"
                                              Icon="{StaticResource IconDamper}"
                                              IsCollapsible="True">
                                <StackPanel>
                                    <ctrl:OffOnToggle x:Name="MBoosterSegDampEnable" Content="{x:Static res:Strings.Label_EnableSegmentedDamping}" VerticalAlignment="Center" Margin="0,0,0,12" Checked="MBoosterSegDampEnable_Changed" Unchecked="MBoosterSegDampEnable_Changed"/>
                                    <!-- Plain (non-segmented) Virtual Damping, cmdId 0xAD selectors
                                         0/1. Latest-wins against the 0xB7 segments on the unit, so
                                         it is shown (and applied) only with Segmented Damping off.
                                         Same card, so it inherits the passive-pedal gating. -->
                                    <StackPanel x:Name="MBoosterPlainDampingPanel">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_DampingPress}" Style="{StaticResource SliderLabel}"/>
                                        <Slider Grid.Column="1" x:Name="MBoosterDampingPressSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="MBoosterDampingSlider_ValueChanged"/>
                                        <TextBox Grid.Column="2" x:Name="MBoosterDampingPressValue" Style="{StaticResource SliderValueEditBox}"
                                                 Tag="{Binding ElementName=MBoosterDampingPressSlider}"
                                                 KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                 Text="0"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
