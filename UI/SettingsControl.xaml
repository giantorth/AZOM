                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Intensity}" Style="{StaticResource LfeLabel}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="BaseLfeAbsIntensityValue" Width="58" Style="{StaticResource SliderValueEditBox}" Tag="{Binding ElementName=BaseLfeAbsIntensity}" KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus" Text="50"/>
                                        <TextBlock Grid.Column="2" x:Name="BaseLfeAbsIntensityCalc" Visibility="Collapsed" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource FontMono}" FontSize="13" Width="58" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Tag="abs:intensity" Click="BaseLfeFx_Click" ToolTip="{x:Static res:Strings.Tooltip_EditFormula}" Width="34" Height="22" Padding="2" Margin="4,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"><TextBlock Text="𝑓(𝑥)" FontFamily="Cambria Math, Segoe UI" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/></Button>
                                    </Grid>
                                    <Slider x:Name="BaseLfeAbsIntensity" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,2,0,0" ValueChanged="BaseLfeAbsIntensity_ValueChanged"/>
                                    <TextBlock x:Name="BaseLfeAbsIntensityFormulaText" Visibility="Collapsed" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource FontMono}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Smoothness}" Style="{StaticResource LfeLabel}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="BaseLfeAbsSmoothnessValue" Width="58" Style="{StaticResource SliderValueEditBox}" Tag="{Binding ElementName=BaseLfeAbsSmoothness}" KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus" Text="100"/>
                                        <TextBlock Grid.Column="2" x:Name="BaseLfeAbsSmoothnessCalc" Visibility="Collapsed" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource FontMono}" FontSize="13" Width="58" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Tag="abs:smoothness" Click="BaseLfeFx_Click" ToolTip="{x:Static res:Strings.Tooltip_EditFormula}" Width="34" Height="22" Padding="2" Margin="4,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"><TextBlock Text="𝑓(𝑥)" FontFamily="Cambria Math, Segoe UI" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/></Button>
                                    </Grid>
                                    <Slider x:Name="BaseLfeAbsSmoothness" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,2,0,0" ValueChanged="BaseLfeAbsSmoothness_ValueChanged"/>
                                    <TextBlock x:Name="BaseLfeAbsSmoothnessFormulaText" Visibility="Collapsed" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource FontMono}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <StackPanel x:Name="BaseLfeAbsEdgeOptions" Visibility="Collapsed">
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_VibrateOnNeutral}" Style="{StaticResource LfeLabel}" VerticalAlignment="Center"/>
                                            <ctrl:OffOnToggle Grid.Column="1" x:Name="BaseLfeAbsVibrateOnNeutral" Tag="abs" Margin="0,0,38,0" VerticalAlignment="Center" Checked="BaseLfeVibrateOnNeutral_Changed" Unchecked="BaseLfeVibrateOnNeutral_Changed"/>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_ShiftDebounce}" Style="{StaticResource LfeLabel}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" x:Name="BaseLfeAbsDebounceValue" Width="58" Margin="0,0,38,0" Style="{StaticResource SliderValueEditBox}" Tag="{Binding ElementName=BaseLfeAbsDebounceSlider}" KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus" Text="50 ms"/>
                                        </Grid>
                                        <Slider x:Name="BaseLfeAbsDebounceSlider" Tag="abs" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="1000" TickFrequency="50" SmallChange="50" LargeChange="50" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="BaseLfeDebounce_ValueChanged"/>
                                    </StackPanel>
                            </StackPanel>
                        </ctrl:SectionCard>
                        <ctrl:SectionCard Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Title="{x:Static res:Strings.Section_EffectsSlot3}" Icon="{StaticResource IconShift}" Margin="7,0,0,0">
                            <ctrl:SectionCard.Header>
                                <Button x:Name="BaseLfeGearshiftTestButton" Content="{x:Static res:Strings.Label_Test}" Padding="10,2" Click="BaseLfeGearshiftTest_Click"/>
                            </ctrl:SectionCard.Header>
                            <StackPanel>
                                <ctrl:OffOnToggle x:Name="BaseLfeGearshiftEnable" Content="{x:Static res:Strings.Label_Enable}" FontSize="14.5" FontWeight="Normal" HorizontalAlignment="Left" Margin="0,0,0,8" Checked="BaseLfeGearshiftEnable_Changed" Unchecked="BaseLfeGearshiftEnable_Changed"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Label_Mode}" Style="{StaticResource LfeLabel}" VerticalAlignment="Center"/>
                                    <ctrl:SegmentedControl Grid.Column="1" x:Name="BaseLfeGearshiftMode" Tag="gearshift" HorizontalAlignment="Left" SelectionChanged="BaseLfeMode_Changed"><ListBoxItem Content="{x:Static res:Strings.Mode_Engine}"/><ListBoxItem Content="{x:Static res:Strings.Mode_Abs}"/><ListBoxItem Content="{x:Static res:Strings.Mode_Gearshift}"/><ListBoxItem Content="{x:Static res:Strings.Mode_Custom}"/></ctrl:SegmentedControl>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Trigger}" Style="{StaticResource LfeLabel}" VerticalAlignment="Center"/>
                                    <ctrl:SegmentedControl Grid.Column="1" x:Name="BaseLfeGearshiftTriggerMode" Tag="gearshift" HorizontalAlignment="Left" SelectionChanged="BaseLfeTriggerMode_Changed"><ListBoxItem Content="{x:Static res:Strings.TriggerMode_Level}"/><ListBoxItem Content="{x:Static res:Strings.TriggerMode_OnChange}"/></ctrl:SegmentedControl>
                                    <TextBlock Grid.Column="2" x:Name="BaseLfeGearshiftTriggerCalc" Visibility="Collapsed" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource FontMono}" FontSize="13" Width="58" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Tag="gearshift:trigger" Click="BaseLfeFx_Click" ToolTip="{x:Static res:Strings.Tooltip_EditFormula}" Width="34" Height="22" Padding="2" Margin="4,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"><TextBlock Text="𝑓(𝑥)" FontFamily="Cambria Math, Segoe UI" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/></Button>
                                </Grid>
                                <TextBlock x:Name="BaseLfeGearshiftTriggerText" Margin="0,4,0,0" Foreground="{StaticResource TextDimBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_FrequencyHz}" Style="{StaticResource LfeLabel}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="BaseLfeGearshiftFrequencyValue" Width="58" Style="{StaticResource SliderValueEditBox}" Tag="{Binding ElementName=BaseLfeGearshiftFrequencySlider}" KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus" Text="100"/>
                                        <TextBlock Grid.Column="2" x:Name="BaseLfeGearshiftFrequencyCalc" Visibility="Collapsed" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource FontMono}" FontSize="13" Width="58" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Tag="gearshift:frequency" Click="BaseLfeFx_Click" ToolTip="{x:Static res:Strings.Tooltip_EditFormula}" Width="34" Height="22" Padding="2" Margin="4,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"><TextBlock Text="𝑓(𝑥)" FontFamily="Cambria Math, Segoe UI" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/></Button>
                                    </Grid>
                                    <Slider x:Name="BaseLfeGearshiftFrequencySlider" Style="{StaticResource SettingSlider}" Minimum="20" Maximum="100" TickFrequency="1" Margin="0,2,0,0" ValueChanged="BaseLfeGearshiftFrequencySlider_ValueChanged"/>
                                    <TextBlock x:Name="BaseLfeGearshiftFrequencyFormulaText" Visibility="Collapsed" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource FontMono}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <StackPanel x:Name="BaseLfeGearshiftFreqLimits" Visibility="Collapsed" Margin="0,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Label_FormulaLimitsHz}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" x:Name="BaseLfeGearshiftFreqRangeText" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource FontMono}" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ctrl:MozaRangeSlider x:Name="BaseLfeGearshiftFreqRange" Tag="gearshift"
                                                              Template="{StaticResource MozaRangeSliderThinTemplate}"
                                                              MinHeight="0" Height="30" EdgePad="8" NodeSize="22" TrackThickness="6"
                                                              Minimum="0" Maximum="200" LowValue="0" HighValue="200"
                                                              RangeChanged="BaseLfeFreqRange_RangeChanged"/>
                                    </StackPanel>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Intensity}" Style="{StaticResource LfeLabel}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="BaseLfeGearshiftIntensityValue" Width="58" Style="{StaticResource SliderValueEditBox}" Tag="{Binding ElementName=BaseLfeGearshiftIntensity}" KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus" Text="50"/>
                                        <TextBlock Grid.Column="2" x:Name="BaseLfeGearshiftIntensityCalc" Visibility="Collapsed" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource FontMono}" FontSize="13" Width="58" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Tag="gearshift:intensity" Click="BaseLfeFx_Click" ToolTip="{x:Static res:Strings.Tooltip_EditFormula}" Width="34" Height="22" Padding="2" Margin="4,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"><TextBlock Text="𝑓(𝑥)" FontFamily="Cambria Math, Segoe UI" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/></Button>
                                    </Grid>
                                    <Slider x:Name="BaseLfeGearshiftIntensity" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,2,0,0" ValueChanged="BaseLfeGearshiftIntensity_ValueChanged"/>
                                    <TextBlock x:Name="BaseLfeGearshiftIntensityFormulaText" Visibility="Collapsed" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource FontMono}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Smoothness}" Style="{StaticResource LfeLabel}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="BaseLfeGearshiftSmoothnessValue" Width="58" Style="{StaticResource SliderValueEditBox}" Tag="{Binding ElementName=BaseLfeGearshiftSmoothness}" KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus" Text="100"/>
                                        <TextBlock Grid.Column="2" x:Name="BaseLfeGearshiftSmoothnessCalc" Visibility="Collapsed" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource FontMono}" FontSize="13" Width="58" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Tag="gearshift:smoothness" Click="BaseLfeFx_Click" ToolTip="{x:Static res:Strings.Tooltip_EditFormula}" Width="34" Height="22" Padding="2" Margin="4,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"><TextBlock Text="𝑓(𝑥)" FontFamily="Cambria Math, Segoe UI" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/></Button>
                                    </Grid>
                                    <Slider x:Name="BaseLfeGearshiftSmoothness" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,2,0,0" ValueChanged="BaseLfeGearshiftSmoothness_ValueChanged"/>
                                    <TextBlock x:Name="BaseLfeGearshiftSmoothnessFormulaText" Visibility="Collapsed" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource FontMono}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <StackPanel x:Name="BaseLfeGearshiftEdgeOptions" Visibility="Collapsed">
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_VibrateOnNeutral}" Style="{StaticResource LfeLabel}" VerticalAlignment="Center"/>
                                            <ctrl:OffOnToggle Grid.Column="1" x:Name="BaseLfeGearshiftVibrateOnNeutral" Tag="gearshift" Margin="0,0,38,0" VerticalAlignment="Center" Checked="BaseLfeVibrateOnNeutral_Changed" Unchecked="BaseLfeVibrateOnNeutral_Changed"/>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_ShiftDebounce}" Style="{StaticResource LfeLabel}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" x:Name="BaseLfeGearshiftDebounceValue" Width="58" Margin="0,0,38,0" Style="{StaticResource SliderValueEditBox}" Tag="{Binding ElementName=BaseLfeGearshiftDebounceSlider}" KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus" Text="50 ms"/>
                                        </Grid>
                                        <Slider x:Name="BaseLfeGearshiftDebounceSlider" Tag="gearshift" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="1000" TickFrequency="50" SmallChange="50" LargeChange="50" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="BaseLfeDebounce_ValueChanged"/>
                                    </StackPanel>
                            </StackPanel>
                        </ctrl:SectionCard>
                        </Grid>
                        <!-- LFE-GEN-END -->
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== HANDBRAKE TAB ==================== -->
            <TabItem x:Name="HandbrakeTab" Header="{x:Static res:Strings.TabHeader_Handbrake}" Visibility="Collapsed">
                <!-- Red accent for active button-selectors (SegmentedControl
                     selected item, OffOnToggle ON pill). The templates resolve
                     these keys via DynamicResource, so overriding them here
                     tints every active control inside the Handbrake tab. -->
                <TabItem.Resources>
                    <StaticResource x:Key="ToggleOnBrush" ResourceKey="RedToggleOnBrush"/>
                    <SolidColorBrush x:Key="ToggleOnTextBrush" Color="{StaticResource RedColor}"/>
                </TabItem.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel Margin="5">

                        <!-- Live Input (POSITION card) + CALIBRATION side-by-side. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ctrl:SectionCard Grid.Column="0" Title="{x:Static res:Strings.Section_Position}"
                                              Subtitle="{x:Static res:Strings.Subtitle_LiveHandbrakeInput}"
                                              Icon="{StaticResource IconHandbrake}"
                                              AccentBrush="{StaticResource RedBrush}"
                                              Margin="0,0,7,14">
                                <StackPanel>
                                    <StackPanel x:Name="HandbrakeAxisPanel" Margin="0,4">
                                        <TextBlock Text="{x:Static res:Strings.Label_Position}" Style="{StaticResource MutedHintText}" Margin="0,0,0,4"/>
                                        <ProgressBar x:Name="HandbrakeBar" Height="14" Minimum="0" Maximum="100" Value="0"
                                                     HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <TextBlock x:Name="HandbrakeButtonStatus" FontFamily="Consolas" FontSize="14"
                                               FontWeight="Normal" Margin="0,4" Visibility="Collapsed"
                                               Text="{x:Static res:Strings.Status_Released}"/>
                                </StackPanel>
                            </ctrl:SectionCard>

                            <ctrl:SectionCard Grid.Column="1" Title="{x:Static res:Strings.Section_Calibration}"
                                              Subtitle="{x:Static res:Strings.Subtitle_PullHandbrakeFully}"
                                              Icon="{StaticResource IconCal}"
                                              AccentBrush="{StaticResource RedBrush}"
                                              Margin="7,0,0,14">
                                <StackPanel Margin="0,4">
                                    <Button x:Name="HbCalStartButton" Content="{x:Static res:Strings.Button_StartCalibration}" HorizontalAlignment="Left" Click="HbCalStartButton_Click"/>
                                    <TextBlock x:Name="HbCalStatus" Style="{StaticResource MutedHintText}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </ctrl:SectionCard>
                        </Grid>

                        <!-- Handbrake Settings + Range side-by-side. -->
                        <!-- HANDBRAKE SETTINGS (mode/threshold/direction + range) on the left,
                             OUTPUT CURVE on the right. Mirrors the BRAKE page's combined
                             "Direction & Range" card style. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ctrl:SectionCard Grid.Column="0" Title="{x:Static res:Strings.Section_HandbrakeSettings}"
                                              Icon="{StaticResource IconHandbrake}"
                                              AccentBrush="{StaticResource RedBrush}" Margin="0,0,7,14">
                                <StackPanel>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Mode}" Style="{StaticResource SliderLabel}"/>
                                        <ctrl:SegmentedControl Grid.Column="1" x:Name="HandbrakeModeCombo"
                                                               HorizontalAlignment="Left"
                                                               SelectionChanged="HandbrakeModeCombo_Changed">
                                            <ListBoxItem Content="{x:Static res:Strings.Option_Axis}"/>
                                            <ListBoxItem Content="{x:Static res:Strings.Option_Button}"/>
                                        </ctrl:SegmentedControl>
                                    </Grid>
                                    <Grid x:Name="HandbrakeThresholdPanel" Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_ButtonThreshold}" Style="{StaticResource SliderLabel}"/>
                                        <Slider Grid.Column="1" x:Name="HandbrakeThresholdSlider" Style="{StaticResource RedSettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="HandbrakeThresholdSlider_ValueChanged"/>
                                        <TextBox Grid.Column="2" x:Name="HandbrakeThresholdValue" Style="{StaticResource RedSliderValueEditBox}"
                                                     Tag="{Binding ElementName=HandbrakeThresholdSlider}"
                                                     KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                     Text="50%"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8">
                                        <TextBlock Text="{x:Static res:Strings.SliderLabel_ReverseDirection}" Style="{StaticResource SliderLabel}"/>
                                        <ctrl:OffOnToggle x:Name="HandbrakeDirectionCheck" VerticalAlignment="Center" Click="HandbrakeDirectionCheck_Click"/>
                                    </StackPanel>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_RangeStart}" Style="{StaticResource SliderLabel}"/>
                                        <Slider Grid.Column="1" x:Name="HandbrakeMinSlider" Style="{StaticResource RedSettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="HandbrakeMinSlider_ValueChanged"/>
                                        <TextBox Grid.Column="2" x:Name="HandbrakeMinValue" Style="{StaticResource RedSliderValueEditBox}"
                                                     Tag="{Binding ElementName=HandbrakeMinSlider}"
                                                     KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                     Text="0%"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_RangeEnd}" Style="{StaticResource SliderLabel}"/>
                                        <Slider Grid.Column="1" x:Name="HandbrakeMaxSlider" Style="{StaticResource RedSettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="HandbrakeMaxSlider_ValueChanged"/>
                                        <TextBox Grid.Column="2" x:Name="HandbrakeMaxValue" Style="{StaticResource RedSliderValueEditBox}"
                                                     Tag="{Binding ElementName=HandbrakeMaxSlider}"
                                                     KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                     Text="100%"/>
                                    </Grid>
                                </StackPanel>
                            </ctrl:SectionCard>

                            <ctrl:SectionCard Grid.Column="1" Title="{x:Static res:Strings.Section_OutputCurve}"
                                              Subtitle="{x:Static res:Strings.Subtitle_MapPhysicalPullToGame}"
                                              Icon="{StaticResource IconCurve}"
                                              AccentBrush="{StaticResource RedBrush}" Margin="7,0,0,14">
                                <StackPanel>
                                    <ctrl:MozaCurveEditor x:Name="HandbrakeCurveEditor" Height="260"
                                                          AccentBrush="{StaticResource RedBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{x:Static res:Strings.Button_Linear}" Margin="0,0,8,0" Click="HbCurvePreset_Linear"/>
                                        <Button Content="{x:Static res:Strings.Button_SCurve}" Margin="0,0,8,0" Click="HbCurvePreset_SCurve"/>
                                        <Button Content="{x:Static res:Strings.Button_Exponential}" Margin="0,0,8,0" Click="HbCurvePreset_Exponential"/>
                                        <Button Content="{x:Static res:Strings.Button_Parabolic}" Click="HbCurvePreset_Parabolic"/>
                                    </StackPanel>
                                </StackPanel>
                            </ctrl:SectionCard>
                        </Grid>

                        <!-- Data-store sliders, driven by HandbrakeCurveEditor -->
                        <StackPanel Visibility="Collapsed">
                            <Slider x:Name="HbY1Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="HbY1Slider_ValueChanged"/>
                            <Slider x:Name="HbY2Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="HbY2Slider_ValueChanged"/>
                            <Slider x:Name="HbY3Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="HbY3Slider_ValueChanged"/>
                            <Slider x:Name="HbY4Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="HbY4Slider_ValueChanged"/>
                            <Slider x:Name="HbY5Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="HbY5Slider_ValueChanged"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== PEDALS TAB ==================== -->
            <TabItem x:Name="PedalsTab" Header="{x:Static res:Strings.TabHeader_Pedals}" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,8">
                    <StackPanel>

                        <!-- Live Input (throttle/brake/clutch scrolling trace) -->
                        <Border Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{x:Static res:Strings.Label_Throttle}" Style="{StaticResource MutedHintText}" Margin="0,0,16,0"/>
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource RedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{x:Static res:Strings.Label_Brake}" Style="{StaticResource MutedHintText}" Margin="0,0,16,0"/>
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource CyanBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{x:Static res:Strings.Label_Clutch}" Style="{StaticResource MutedHintText}"/>
                                </StackPanel>
                                <ctrl:BandwidthSparkline x:Name="PedalTraceViz" Height="80"
                                                          InBrush="{StaticResource RedBrush}"
                                                          InFillBrush="{StaticResource McuFillBrush}"
                                                          OutBrush="{StaticResource GreenBrush}"
                                                          OutFillBrush="{StaticResource MotorFillBrush}"
                                                          ThirdBrush="{StaticResource CyanBrush}"
                                                          ThirdFillBrush="{StaticResource BwThirdFillBrush}"
                                                          MaxValue="100"
                                                          ShowGridlines="True"/>
                            </StackPanel>
                        </Border>

                        <!-- One column per pedal. Rows=1 lets UniformGrid skip a
                             Collapsed column (passive mode) and widen the rest. -->
                        <UniformGrid Rows="1" Margin="-5,0">

                        <!-- ===== THROTTLE ===== -->
                        <ctrl:SectionCard x:Name="ThrottlePedalGroup" Title="{x:Static res:Strings.Label_Throttle}"
                                          Icon="{StaticResource IconPedals}"
                                          AccentBrush="{StaticResource GreenBrush}"
                                          Margin="5,0,5,14">
                            <ctrl:SectionCard.Resources>
                                <StaticResource x:Key="ToggleOnBrush" ResourceKey="GreenToggleOnBrush"/>
                                <SolidColorBrush x:Key="ToggleOnTextBrush" Color="{StaticResource GreenColor}"/>
                            </ctrl:SectionCard.Resources>
                            <ctrl:SectionCard.Header>
                                <Button x:Name="ThrottleCalStartButton" Content="{x:Static res:Strings.Button_Calibrate}" Padding="10,2" Click="ThrottleCalStartButton_Click"/>
                            </ctrl:SectionCard.Header>
                            <StackPanel>
                                <TextBlock x:Name="ThrottleCalStatus" Style="{StaticResource MutedHintText}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
                                <ProgressBar x:Name="ThrottleLiveBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                             Foreground="{StaticResource GreenBrush}" Margin="0,0,0,12"/>
                                <ctrl:MozaCurveEditor x:Name="ThrottleCurveEditor" Height="200"
                                                      AccentBrush="{StaticResource GreenBrush}"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="{x:Static res:Strings.Button_Linear}" Margin="0,0,6,6" Click="ThrottleCurvePreset_Linear"/>
                                    <Button Content="{x:Static res:Strings.Button_SCurve}" Margin="0,0,6,6" Click="ThrottleCurvePreset_SCurve"/>
                                    <Button Content="{x:Static res:Strings.Button_Exponential}" Margin="0,0,6,6" Click="ThrottleCurvePreset_Exponential"/>
                                    <Button Content="{x:Static res:Strings.Button_Parabolic}" Margin="0,0,6,6" Click="ThrottleCurvePreset_Parabolic"/>
                                </WrapPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_ReverseDirection}" Style="{StaticResource LabelText}" TextWrapping="Wrap"/>
                                    <ctrl:OffOnToggle Grid.Column="1" x:Name="ThrottleDirCheck" VerticalAlignment="Center" Click="ThrottleDirCheck_Click"/>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Range}" Style="{StaticResource LabelText}"/>
                                    <TextBlock Grid.Column="1" x:Name="ThrottleRangeText" Text="0 – 100%" FontFamily="{StaticResource FontMono}" FontSize="13" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <ctrl:MozaRangeSlider x:Name="ThrottleRange" Template="{StaticResource MozaRangeSliderAccentTemplate}"
                                                      AccentBrush="{StaticResource GreenBrush}"
                                                      MinHeight="0" Height="30" EdgePad="8" NodeSize="22" TrackThickness="6"
                                                      Minimum="0" Maximum="100" Decimals="0" LowValue="0" HighValue="100"
                                                      Margin="0,2,0,0" RangeChanged="ThrottleRange_RangeChanged"/>
                                <!-- Data-store sliders, driven by ThrottleCurveEditor -->
                                <StackPanel Visibility="Collapsed">
                                    <Slider x:Name="ThrottleY1Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="ThrottleY1Slider_ValueChanged"/>
                                    <Slider x:Name="ThrottleY2Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="ThrottleY2Slider_ValueChanged"/>
                                    <Slider x:Name="ThrottleY3Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="ThrottleY3Slider_ValueChanged"/>
                                    <Slider x:Name="ThrottleY4Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="ThrottleY4Slider_ValueChanged"/>
                                    <Slider x:Name="ThrottleY5Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="ThrottleY5Slider_ValueChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </ctrl:SectionCard>

                        <!-- ===== BRAKE ===== -->
                        <ctrl:SectionCard x:Name="BrakePedalGroup" Title="{x:Static res:Strings.Label_Brake}"
                                          Icon="{StaticResource IconPedals}"
                                          AccentBrush="{StaticResource RedBrush}"
                                          Margin="5,0,5,14">
                            <ctrl:SectionCard.Resources>
                                <StaticResource x:Key="ToggleOnBrush" ResourceKey="RedToggleOnBrush"/>
                                <SolidColorBrush x:Key="ToggleOnTextBrush" Color="{StaticResource RedColor}"/>
                            </ctrl:SectionCard.Resources>
                            <ctrl:SectionCard.Header>
                                <Button x:Name="BrakeCalStartButton" Content="{x:Static res:Strings.Button_Calibrate}" Padding="10,2" Click="BrakeCalStartButton_Click"/>
                            </ctrl:SectionCard.Header>
                            <StackPanel>
                                <TextBlock x:Name="BrakeCalStatus" Style="{StaticResource MutedHintText}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
                                <ProgressBar x:Name="BrakeLiveBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                             Foreground="{StaticResource RedBrush}" Margin="0,0,0,12"/>
                                <ctrl:MozaCurveEditor x:Name="BrakeCurveEditor" Height="200"
                                                      AccentBrush="{StaticResource RedBrush}"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="{x:Static res:Strings.Button_Linear}" Margin="0,0,6,6" Click="BrakeCurvePreset_Linear"/>
                                    <Button Content="{x:Static res:Strings.Button_SCurve}" Margin="0,0,6,6" Click="BrakeCurvePreset_SCurve"/>
                                    <Button Content="{x:Static res:Strings.Button_Exponential}" Margin="0,0,6,6" Click="BrakeCurvePreset_Exponential"/>
                                    <Button Content="{x:Static res:Strings.Button_Parabolic}" Margin="0,0,6,6" Click="BrakeCurvePreset_Parabolic"/>
                                </WrapPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_ReverseDirection}" Style="{StaticResource LabelText}" TextWrapping="Wrap"/>
                                    <ctrl:OffOnToggle Grid.Column="1" x:Name="BrakeDirCheck" VerticalAlignment="Center" Click="BrakeDirCheck_Click"/>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Range}" Style="{StaticResource LabelText}"/>
                                    <TextBlock Grid.Column="1" x:Name="BrakeRangeText" Text="0 – 100%" FontFamily="{StaticResource FontMono}" FontSize="13" Foreground="{StaticResource RedBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <ctrl:MozaRangeSlider x:Name="BrakeRange" Template="{StaticResource MozaRangeSliderAccentTemplate}"
                                                      AccentBrush="{StaticResource RedBrush}"
                                                      MinHeight="0" Height="30" EdgePad="8" NodeSize="22" TrackThickness="6"
                                                      Minimum="0" Maximum="100" Decimals="0" LowValue="0" HighValue="100"
                                                      Margin="0,2,0,0" RangeChanged="BrakeRange_RangeChanged"/>
                                <StackPanel x:Name="BrakeAngleRatioRow" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_SensorRatio}" Style="{StaticResource LabelText}" TextWrapping="Wrap"/>
                                        <TextBox Grid.Column="1" x:Name="BrakeAngleRatioValue" Style="{StaticResource RedSliderValueEditBox}"
                                                 Tag="{Binding ElementName=BrakeAngleRatioSlider}"
                                                 KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                 Text="50%"/>
                                    </Grid>
                                    <Slider x:Name="BrakeAngleRatioSlider" Style="{StaticResource RedSettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,2,0,0" ValueChanged="BrakeAngleRatioSlider_ValueChanged"/>
                                </StackPanel>
                                <!-- Data-store sliders, driven by BrakeCurveEditor -->
                                <StackPanel Visibility="Collapsed">
                                    <Slider x:Name="BrakeY1Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="BrakeY1Slider_ValueChanged"/>
                                    <Slider x:Name="BrakeY2Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="BrakeY2Slider_ValueChanged"/>
                                    <Slider x:Name="BrakeY3Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="BrakeY3Slider_ValueChanged"/>
                                    <Slider x:Name="BrakeY4Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="BrakeY4Slider_ValueChanged"/>
                                    <Slider x:Name="BrakeY5Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="BrakeY5Slider_ValueChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </ctrl:SectionCard>

                        <!-- ===== CLUTCH ===== -->
                        <ctrl:SectionCard x:Name="ClutchPedalGroup" Title="{x:Static res:Strings.Label_Clutch}"
                                          Icon="{StaticResource IconPedals}"
                                          AccentBrush="{StaticResource CyanBrush}"
                                          Margin="5,0,5,14">
                            <ctrl:SectionCard.Header>
                                <Button x:Name="ClutchCalStartButton" Content="{x:Static res:Strings.Button_Calibrate}" Padding="10,2" Click="ClutchCalStartButton_Click"/>
                            </ctrl:SectionCard.Header>
                            <StackPanel>
                                <TextBlock x:Name="ClutchCalStatus" Style="{StaticResource MutedHintText}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
                                <ProgressBar x:Name="ClutchLiveBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                             Foreground="{StaticResource CyanBrush}" Margin="0,0,0,12"/>
                                <ctrl:MozaCurveEditor x:Name="ClutchCurveEditor" Height="200"
                                                      AccentBrush="{StaticResource CyanBrush}"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="{x:Static res:Strings.Button_Linear}" Margin="0,0,6,6" Click="ClutchCurvePreset_Linear"/>
                                    <Button Content="{x:Static res:Strings.Button_SCurve}" Margin="0,0,6,6" Click="ClutchCurvePreset_SCurve"/>
                                    <Button Content="{x:Static res:Strings.Button_Exponential}" Margin="0,0,6,6" Click="ClutchCurvePreset_Exponential"/>
                                    <Button Content="{x:Static res:Strings.Button_Parabolic}" Margin="0,0,6,6" Click="ClutchCurvePreset_Parabolic"/>
                                </WrapPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_ReverseDirection}" Style="{StaticResource LabelText}" TextWrapping="Wrap"/>
                                    <ctrl:OffOnToggle Grid.Column="1" x:Name="ClutchDirCheck" VerticalAlignment="Center" Click="ClutchDirCheck_Click"/>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Range}" Style="{StaticResource LabelText}"/>
                                    <TextBlock Grid.Column="1" x:Name="ClutchRangeText" Text="0 – 100%" FontFamily="{StaticResource FontMono}" FontSize="13" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <ctrl:MozaRangeSlider x:Name="ClutchRange" Template="{StaticResource MozaRangeSliderAccentTemplate}"
                                                      AccentBrush="{StaticResource CyanBrush}"
                                                      MinHeight="0" Height="30" EdgePad="8" NodeSize="22" TrackThickness="6"
                                                      Minimum="0" Maximum="100" Decimals="0" LowValue="0" HighValue="100"
                                                      Margin="0,2,0,0" RangeChanged="ClutchRange_RangeChanged"/>
                                <!-- Data-store sliders, driven by ClutchCurveEditor -->
                                <StackPanel Visibility="Collapsed">
                                    <Slider x:Name="ClutchY1Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="ClutchY1Slider_ValueChanged"/>
                                    <Slider x:Name="ClutchY2Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="ClutchY2Slider_ValueChanged"/>
                                    <Slider x:Name="ClutchY3Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="ClutchY3Slider_ValueChanged"/>
                                    <Slider x:Name="ClutchY4Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="ClutchY4Slider_ValueChanged"/>
                                    <Slider x:Name="ClutchY5Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="ClutchY5Slider_ValueChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </ctrl:SectionCard>

                        </UniformGrid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== S12 HAPTICS TAB ====================
                 Plugin-driven S12 pedal vibration, shown only while Options routes
                 the unit to the plugin tab. One card per firmware channel; content
                 between the GEN markers is generated by tools/rebuild_s12_cards.py. -->
            <TabItem x:Name="PedalHapticsTab" Header="{x:Static res:Strings.TabHeader_PedalHaptics}" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,8">
                    <StackPanel>
                        <!-- S12-GEN-START -->
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ctrl:SectionCard Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" Title="{x:Static res:Strings.Section_PedalHapticsOutput}" Icon="{StaticResource IconShift}" Margin="0,0,7,14">
                                <ctrl:SectionCard.Header>
                                    <Button Content="{x:Static res:Strings.Label_Test}" Padding="10,2" Click="S12TestAll_Click"/>
                                </ctrl:SectionCard.Header>
                                <StackPanel>
                                    <ctrl:LfeScope x:Name="S12Scope" Height="168" MaxHz="100"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Rectangle Width="10" Height="10" Fill="#FF3CE0E0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Static res:Strings.Option_Throttle}" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="4,0,12,0" VerticalAlignment="Center"/>
                                        <Rectangle Width="10" Height="10" Fill="#FFFFB84D" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Static res:Strings.Option_Brake}" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="4,0,12,0" VerticalAlignment="Center"/>
                                        <Rectangle Width="10" Height="10" Fill="#FF8BD866" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Static res:Strings.Option_Clutch}" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </ctrl:SectionCard>
                            <ctrl:SectionCard Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" Title="{x:Static res:Strings.Section_TractionControl}" Icon="{StaticResource IconShift}" Margin="7,0,0,14">
                                <ctrl:SectionCard.Header>
                                    <Button Content="{x:Static res:Strings.Label_Test}" Tag="tc" Padding="10,2" Click="S12Test_Click"/>
                                </ctrl:SectionCard.Header>
                                <StackPanel>
                                    <ctrl:OffOnToggle x:Name="S12TcEnable" Tag="tc" Content="{x:Static res:Strings.Label_Enable}" FontSize="14.5" FontWeight="Normal" HorizontalAlignment="Left" Margin="0,0,0,8" Checked="S12Enable_Changed" Unchecked="S12Enable_Changed"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Label_Pedals}" Style="{StaticResource LfeLabel}" VerticalAlignment="Center"/>
                                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                            <ctrl:OffOnToggle x:Name="S12TcThrottle" Tag="tc:throttle" Content="{x:Static res:Strings.Option_Throttle}" FontWeight="Normal" Margin="0,0,12,0" Checked="S12Pedal_Changed" Unchecked="S12Pedal_Changed"/>
                                            <ctrl:OffOnToggle x:Name="S12TcBrake" Tag="tc:brake" Content="{x:Static res:Strings.Option_Brake}" FontWeight="Normal" Margin="0,0,12,0" Checked="S12Pedal_Changed" Unchecked="S12Pedal_Changed"/>
                                            <ctrl:OffOnToggle x:Name="S12TcClutch" Tag="tc:clutch" Content="{x:Static res:Strings.Option_Clutch}" FontWeight="Normal" Margin="0,0,12,0" Checked="S12Pedal_Changed" Unchecked="S12Pedal_Changed"/>
                                        </WrapPanel>
                                    </Grid>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Trigger}" Style="{StaticResource LfeLabel}" VerticalAlignment="Center"/>
                                        <ctrl:SegmentedControl Grid.Column="1" x:Name="S12TcTriggerMode" Tag="tc" HorizontalAlignment="Left" SelectionChanged="S12TriggerMode_Changed"><ListBoxItem Content="{x:Static res:Strings.TriggerMode_Level}"/><ListBoxItem Content="{x:Static res:Strings.TriggerMode_OnChange}"/></ctrl:SegmentedControl>
                                        <TextBlock Grid.Column="2" x:Name="S12TcTriggerCalc" Visibility="Collapsed" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource FontMono}" FontSize="13" Width="58" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Tag="tc:trigger" Click="S12Fx_Click" ToolTip="{x:Static res:Strings.Tooltip_EditFormula}" Width="34" Height="22" Padding="2" Margin="4,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"><TextBlock Text="𝑓(𝑥)" FontFamily="Cambria Math, Segoe UI" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/></Button>
                                    </Grid>
                                    <TextBlock x:Name="S12TcTriggerText" Margin="0,4,0,0" Foreground="{StaticResource TextDimBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_FrequencyHz}" Style="{StaticResource LfeLabel}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="S12TcFrequencyValue" Width="58" Style="{StaticResource SliderValueEditBox}" Tag="{Binding ElementName=S12TcFrequencySlider}" KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"/>
                                        <TextBlock Grid.Column="2" x:Name="S12TcFrequencyCalc" Visibility="Collapsed" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource FontMono}" FontSize="13" Width="58" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Tag="tc:frequency" Click="S12Fx_Click" ToolTip="{x:Static res:Strings.Tooltip_EditFormula}" Width="34" Height="22" Padding="2" Margin="4,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"><TextBlock Text="𝑓(𝑥)" FontFamily="Cambria Math, Segoe UI" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/></Button>
                                    </Grid>
                                    <Slider x:Name="S12TcFrequencySlider" Tag="tc" Style="{StaticResource SettingSlider}" Minimum="10" Maximum="100" TickFrequency="1" Margin="0,2,0,0" ValueChanged="S12Frequency_ValueChanged"/>
                                    <TextBlock x:Name="S12TcFrequencyFormulaText" Visibility="Collapsed" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource FontMono}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <StackPanel x:Name="S12TcFreqLimits" Visibility="Collapsed" Margin="0,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Label_FormulaLimitsHz}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" x:Name="S12TcFreqRangeText" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource FontMono}" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ctrl:MozaRangeSlider x:Name="S12TcFreqRange" Tag="tc" Template="{StaticResource MozaRangeSliderThinTemplate}" MinHeight="0" Height="30" EdgePad="8" NodeSize="22" TrackThickness="6" Minimum="10" Maximum="100" LowValue="10" HighValue="100" RangeChanged="S12FreqRange_RangeChanged"/>
                                    </StackPanel>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Intensity}" Style="{StaticResource LfeLabel}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="S12TcIntensityValue" Width="58" Style="{StaticResource SliderValueEditBox}" Tag="{Binding ElementName=S12TcIntensity}" KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"/>
                                        <TextBlock Grid.Column="2" x:Name="S12TcIntensityCalc" Visibility="Collapsed" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource FontMono}" FontSize="13" Width="58" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Tag="tc:intensity" Click="S12Fx_Click" ToolTip="{x:Static res:Strings.Tooltip_EditFormula}" Width="34" Height="22" Padding="2" Margin="4,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"><TextBlock Text="𝑓(𝑥)" FontFamily="Cambria Math, Segoe UI" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/></Button>
                                    </Grid>
                                    <Slider x:Name="S12TcIntensity" Tag="tc" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,2,0,0" ValueChanged="S12Intensity_ValueChanged"/>
                                    <TextBlock x:Name="S12TcIntensityFormulaText" Visibility="Collapsed" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource FontMono}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <StackPanel x:Name="S12TcEdgeOptions" Visibility="Collapsed">
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_PulseLength}" Style="{StaticResource LfeLabel}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" x:Name="S12TcPulseValue" Width="58" Margin="0,0,38,0" Style="{StaticResource SliderValueEditBox}" Tag="{Binding ElementName=S12TcPulseSlider}" KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"/>
                                        </Grid>
                                        <Slider x:Name="S12TcPulseSlider" Tag="tc" Style="{StaticResource SettingSlider}" Minimum="20" Maximum="1000" TickFrequency="10" SmallChange="10" LargeChange="50" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="S12Pulse_ValueChanged"/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_VibrateOnNeutral}" Style="{StaticResource LfeLabel}" VerticalAlignment="Center"/>
                                            <ctrl:OffOnToggle Grid.Column="1" x:Name="S12TcVibrateOnNeutral" Tag="tc" Margin="0,0,38,0" VerticalAlignment="Center" Checked="S12VibrateOnNeutral_Changed" Unchecked="S12VibrateOnNeutral_Changed"/>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_ShiftDebounce}" Style="{StaticResource LfeLabel}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" x:Name="S12TcDebounceValue" Width="58" Margin="0,0,38,0" Style="{StaticResource SliderValueEditBox}" Tag="{Binding ElementName=S12TcDebounceSlider}" KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"/>
                                        </Grid>
                                        <Slider x:Name="S12TcDebounceSlider" Tag="tc" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="1000" TickFrequency="50" SmallChange="50" LargeChange="50" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="S12Debounce_ValueChanged"/>
                                    </StackPanel>
