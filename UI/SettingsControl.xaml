                            </ctrl:SectionCard>

                            <ctrl:SectionCard Grid.Column="1" Title="{x:Static res:Strings.Section_GameEffects}"
                                              Icon="{StaticResource IconGame}" Margin="7,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
