                                    <TextBlock Text="2" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="4,0,12,0" VerticalAlignment="Center"/>
                                    <Rectangle Width="10" Height="10" Fill="#FF8BD866" VerticalAlignment="Center"/>
                                    <TextBlock Text="3" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </ctrl:SectionCard>
