                                                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                                    <ListBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding}" FontFamily="{DynamicResource FontMono}"
                                                                                       FontSize="12" Foreground="{DynamicResource TextBrush}" Padding="6,3"/>
                                                                        </DataTemplate>
                                                                    </ListBox.ItemTemplate>
                                                                </ListBox>
                                                            </StackPanel>
                                                        </Border>
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <ctrl:OffOnToggle Content="{x:Static res:Strings.Label_UseThreshold}" IsChecked="{Binding ThresholdEnabled}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Grid Margin="0,4" IsEnabled="{Binding ThresholdEnabled}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Threshold}" Style="{StaticResource SliderLabel}"/>
                                                            <Slider Grid.Column="1" Style="{StaticResource SettingSlider}" Minimum="-1000" Maximum="1000" TickFrequency="10"
                                                                    Value="{Binding Threshold}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding ThresholdDisplay}" Style="{StaticResource SliderLabel}" MinWidth="50"/>
                                                        </Grid>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_FrequencyHz}" Style="{StaticResource SliderLabel}"/>
                                                            <Slider Grid.Column="1" Style="{StaticResource SettingSlider}" Minimum="5" Maximum="200" TickFrequency="1"
                                                                    Value="{Binding FrequencyHz}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding FrequencyDisplay}" Style="{StaticResource SliderLabel}" MinWidth="50"/>
                                                        </Grid>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Intensity}" Style="{StaticResource SliderLabel}"/>
                                                            <Slider Grid.Column="1" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" TickFrequency="1"
                                                                    Value="{Binding IntensityPct}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding IntensityDisplay}" Style="{StaticResource SliderLabel}" MinWidth="50"/>
                                                        </Grid>
                                                        <Button Content="{x:Static res:Strings.Button_DeleteCustomEffect}" Margin="0,10,0,0"
                                                                HorizontalAlignment="Left" Style="{StaticResource MozaButtonDanger}"
                                                                Click="MBoosterDeleteCustomEffect_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button x:Name="MBoosterAddCustomEffectButton" Content="{x:Static res:Strings.Button_AddCustomEffect}"
                                            Margin="0,4,0,0" HorizontalAlignment="Left" Click="MBoosterAddCustomEffectButton_Click"/>
                                </StackPanel>
                            </ctrl:SectionCard>

                            <!-- Lane-wide, host unit only (0xB4). -->
                            <ctrl:SectionCard Title="{x:Static res:Strings.Section_Sleep}" Icon="{StaticResource IconMisc}"
                                              IsCollapsible="True">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_SleepTimeout}" Style="{StaticResource SliderLabel}"/>
                                    <Slider Grid.Column="1" x:Name="MBoosterSleepSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="300" TickFrequency="1" ValueChanged="MBoosterSleepSlider_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="MBoosterSleepValue" Style="{StaticResource SliderValueEditBox}"
                                             Tag="{Binding ElementName=MBoosterSleepSlider}"
                                             KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                             Text="0"/>
                                </Grid>
                            </ctrl:SectionCard>

                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ==================== AB9 SHIFTER TAB ==================== -->
            <TabItem x:Name="Ab9Tab" Header="{x:Static res:Strings.TabHeader_Ab9Shifter}" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,8">
                    <StackPanel>

                        <!-- Input mode + layout pickers (left) · live gate (right). -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ctrl:SectionCard Grid.Column="0" Margin="0,0,7,14"
                                              Title="{x:Static res:Strings.Section_ShifterSettings}" Icon="{StaticResource IconShift}">
                                <Grid VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.Section_Ab9InputMode}"
                                               Style="{StaticResource SliderLabel}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="Ab9InputModeCombo" Grid.Row="0" Grid.Column="1" Margin="0,4"
                                              SelectionChanged="Ab9InputModeCombo_Changed">
                                        <ComboBoxItem Content="{x:Static res:Strings.Option_Ab9Shifter}" Tag="1"/>
                                        <ComboBoxItem Content="{x:Static res:Strings.Option_Ab9FlightSim}" Tag="0"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.Label_ShifterType}"
                                               Style="{StaticResource SliderLabel}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="Ab9ModeCombo" Grid.Row="1" Grid.Column="1" Margin="0,4"
                                              SelectionChanged="Ab9ModeCombo_Changed">
                                        <!-- Tag = the 0x1F/D3 layout byte. Ordered by that byte,
                                             which interleaves the R+n layouts with the n+R ones. -->
                                        <ComboBoxItem Content="{x:Static res:Strings.Option_Ab9Layout5R1}" Tag="0"/>
                                        <ComboBoxItem Content="{x:Static res:Strings.Option_Ab9Layout5R2}" Tag="1"/>
                                        <ComboBoxItem Content="{x:Static res:Strings.Option_Ab9LayoutR5}"  Tag="2"/>
                                        <ComboBoxItem Content="{x:Static res:Strings.Option_Ab9LayoutR6}"  Tag="3"/>
                                        <ComboBoxItem Content="{x:Static res:Strings.Option_Ab9Layout6R1}" Tag="4"/>
                                        <ComboBoxItem Content="{x:Static res:Strings.Option_Ab9Layout6R2}" Tag="5"/>
                                        <ComboBoxItem Content="{x:Static res:Strings.Option_Ab9Layout7R1}" Tag="6"/>
                                        <ComboBoxItem Content="{x:Static res:Strings.Option_Ab9Layout7R2}" Tag="7"/>
                                        <ComboBoxItem Content="{x:Static res:Strings.Option_Ab9LayoutR8}"  Tag="8"/>
                                        <ComboBoxItem Content="{x:Static res:Strings.Option_Sequential}"   Tag="9"/>
                                    </ComboBox>
                                </Grid>
                            </ctrl:SectionCard>
                            <ctrl:SectionCard Grid.Column="1" Margin="7,0,0,14"
                                              Title="{x:Static res:Strings.Section_MechanicalLayout}" Icon="{StaticResource IconShift}">
                                <!-- Live gate for the selected layout; engaged gear from the AB9 HID. -->
                                <ctrl:Ab9GateView x:Name="Ab9GateView" Height="130" Margin="0,4" Visibility="Collapsed"/>
                            </ctrl:SectionCard>
                        </Grid>

                        <!-- Feel (left) · Engine vibration + Gear shift (right) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                        <ctrl:SectionCard Grid.Column="0" Margin="0,0,7,14"
                                          Title="{x:Static res:Strings.Section_Feel}"
                                          Subtitle="{x:Static res:Strings.Subtitle_PerAxisMechanicalCharacter}"
                                          Icon="{StaticResource IconDamper}">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_MechanicalResistance}" Style="{StaticResource SliderLabel}"/>
                                    <Slider Grid.Column="1" x:Name="Ab9MechResistanceSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="Ab9MechResistanceSlider_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="Ab9MechResistanceValue" Style="{StaticResource SliderValueEditBox}"
                                                 Tag="{Binding ElementName=Ab9MechResistanceSlider}"
                                                 KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                 Text="50"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Spring}" Style="{StaticResource SliderLabel}"/>
                                    <Slider Grid.Column="1" x:Name="Ab9SpringSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="Ab9SpringSlider_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="Ab9SpringValue" Style="{StaticResource SliderValueEditBox}"
                                                 Tag="{Binding ElementName=Ab9SpringSlider}"
                                                 KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                 Text="50"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_NaturalDamping}" Style="{StaticResource SliderLabel}"/>
                                    <Slider Grid.Column="1" x:Name="Ab9DampingSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="Ab9DampingSlider_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="Ab9DampingValue" Style="{StaticResource SliderValueEditBox}"
                                                 Tag="{Binding ElementName=Ab9DampingSlider}"
                                                 KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                 Text="50"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_NaturalFriction}" Style="{StaticResource SliderLabel}"/>
                                    <Slider Grid.Column="1" x:Name="Ab9FrictionSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="Ab9FrictionSlider_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="Ab9FrictionValue" Style="{StaticResource SliderValueEditBox}"
                                                 Tag="{Binding ElementName=Ab9FrictionSlider}"
                                                 KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                 Text="50"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_MaxOutputTorqueLimit}" Style="{StaticResource SliderLabel}"/>
                                    <Slider Grid.Column="1" x:Name="Ab9MaxTorqueSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="Ab9MaxTorqueSlider_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="Ab9MaxTorqueValue" Style="{StaticResource SliderValueEditBox}"
                                                 Tag="{Binding ElementName=Ab9MaxTorqueSlider}"
                                                 KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                 Text="50"/>
                                </Grid>
                            </StackPanel>
                        </ctrl:SectionCard>

                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                        <ctrl:SectionCard Title="{x:Static res:Strings.Section_EngineVibration}"
                                          Subtitle="{x:Static res:Strings.Subtitle_HostRenderedRumble}"
                                          Icon="{StaticResource IconBolt}">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Intensity}" Style="{StaticResource SliderLabel}"/>
                                    <Slider Grid.Column="1" x:Name="Ab9EngineVibIntensitySlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="Ab9EngineVibIntensitySlider_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="Ab9EngineVibIntensityValue" Style="{StaticResource SliderValueEditBox}"
                                                 Tag="{Binding ElementName=Ab9EngineVibIntensitySlider}"
                                                 KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                 Text="0"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Frequency}" Style="{StaticResource SliderLabel}"/>
                                    <Slider Grid.Column="1" x:Name="Ab9EngineVibFreqSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="200" TickFrequency="10" ValueChanged="Ab9EngineVibFreqSlider_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="Ab9EngineVibFreqValue" Style="{StaticResource SliderValueEditBox}"
                                                 Tag="{Binding ElementName=Ab9EngineVibFreqSlider}"
                                                 KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                 Text="100 Hz"/>
                                </Grid>
                            </StackPanel>
                        </ctrl:SectionCard>

                        <ctrl:SectionCard Title="{x:Static res:Strings.Section_GearShift}" Icon="{StaticResource IconShift}">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_VibrationIntensity}" Style="{StaticResource SliderLabel}"/>
                                    <Slider Grid.Column="1" x:Name="Ab9GearShiftVibSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="Ab9GearShiftVibSlider_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="Ab9GearShiftVibValue" Style="{StaticResource SliderValueEditBox}"
                                                     Tag="{Binding ElementName=Ab9GearShiftVibSlider}"
                                                     KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                     Text="0"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="{x:Static res:Strings.SliderLabel_VibrateOnNeutral}" Style="{StaticResource SliderLabel}"/>
                                    <ctrl:OffOnToggle x:Name="Ab9GearShiftVibrateOnNeutralCheck" VerticalAlignment="Center"
                                                      Checked="Ab9GearShiftVibrateOnNeutralCheck_Changed" Unchecked="Ab9GearShiftVibrateOnNeutralCheck_Changed"/>
                                </StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_ShiftDebounce}" Style="{StaticResource SliderLabel}"/>
                                    <Slider Grid.Column="1" x:Name="Ab9GearShiftDebounceSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="1000" TickFrequency="50" SmallChange="50" LargeChange="50" IsSnapToTickEnabled="True" ValueChanged="Ab9GearShiftDebounceSlider_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="Ab9GearShiftDebounceValue" Style="{StaticResource SliderValueEditBox}"
                                                     Tag="{Binding ElementName=Ab9GearShiftDebounceSlider}"
                                                     KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                     Text="500 ms"/>
                                </Grid>
                            </StackPanel>
                        </ctrl:SectionCard>
                        </StackPanel>

                        </Grid>

                        <!-- The AB9's main answers the wheelbase's read-only status group
                             0x2B on its own dev 0x12. Only the registers that carry data
                             are shown: the base's mosfet / motor / torque registers reply
                             a constant zero here and group 0x1E answers nothing for them,
                             so neither is asked. Header is a register identifier, not
                             prose. docs/protocol/devices/ab9-shifter.md -->
                        <ctrl:SectionCard Title="{x:Static res:Strings.Section_Ab9StatusProbe}"
                                          Icon="{StaticResource IconDiag}" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="Ab9StatusProbeButton" Margin="0,0,14,0"
                                            Content="{x:Static res:Strings.Button_ReadFromDevice}"
                                            Click="Ab9StatusProbeButton_Click"/>
                                    <TextBlock Text="{x:Static res:Strings.Label_Ab9PollLive}"
                                               Style="{StaticResource LabelText}" Margin="0,0,8,0"/>
                                    <ctrl:OffOnToggle x:Name="Ab9StatusPollCheck" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="grp 0x2B  dev 0x12"
                                               Style="{StaticResource SliderRangeEndLabel}" Margin="9,0,0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,0"
                                               Text="{x:Static res:Strings.Label_State}" Style="{StaticResource LabelText}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="Ab9State2bValue"
                                               Style="{StaticResource ValueText}" TextAlignment="Left" Text="—"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,0"
                                               Text="{x:Static res:Strings.Label_StateError}" Style="{StaticResource LabelText}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="Ab9StateErr2bValue"
                                               Style="{StaticResource ValueText}" TextAlignment="Left" Text="—"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,12,0"
                                               Text="{x:Static res:Strings.Brand_Mcu}" Style="{StaticResource LabelText}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="Ab9Mcu2bValue"
                                               Style="{StaticResource ValueText}" TextAlignment="Left" Text="—"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="{x:Static res:Strings.Label_Ab9LayoutReadback}"
                                               Style="{StaticResource LabelText}" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="Ab9ModeReadbackValue" Style="{StaticResource ValueText}"
                                               TextAlignment="Left" Text="—"/>
                                </StackPanel>
                            </StackPanel>
                        </ctrl:SectionCard>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== HGP SHIFTER TAB (H-pattern) ==================== -->
            <TabItem x:Name="HgpTab" Header="{x:Static res:Strings.TabHeader_ShifterHgp}" Visibility="Collapsed">
                <TabItem.Resources>
                    <StaticResource x:Key="ToggleOnBrush" ResourceKey="RedToggleOnBrush"/>
                    <SolidColorBrush x:Key="ToggleOnTextBrush" Color="{StaticResource RedColor}"/>
                </TabItem.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel Margin="5">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Shifter settings -->
                            <ctrl:SectionCard Grid.Column="0" Title="{x:Static res:Strings.Section_ShifterSettings}"
                                              Icon="{StaticResource IconShift}"
                                              AccentBrush="{StaticResource RedBrush}" Margin="0,0,7,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8">
                                        <TextBlock Text="{x:Static res:Strings.SliderLabel_ReverseDirection}" Style="{StaticResource SliderLabel}"/>
                                        <ctrl:OffOnToggle x:Name="HgpDirectionCheck" VerticalAlignment="Center" Click="HgpDirectionCheck_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8">
                                        <TextBlock Text="{x:Static res:Strings.SliderLabel_ShifterPaddleSync}" Style="{StaticResource SliderLabel}"/>
                                        <ctrl:OffOnToggle x:Name="HgpPaddleSyncCheck" VerticalAlignment="Center" Click="HgpPaddleSyncCheck_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8">
                                        <TextBlock Text="{x:Static res:Strings.Label_ShifterType}" Style="{StaticResource SliderLabel}"/>
                                        <ComboBox x:Name="HgpTypeCombo" Width="170" VerticalAlignment="Center" SelectionChanged="HgpTypeCombo_Changed">
                                            <ComboBoxItem Content="{x:Static res:Strings.Option_HPattern}"/>
                                            <ComboBoxItem Content="{x:Static res:Strings.Option_Sequential}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </ctrl:SectionCard>

                            <!-- Calibration (HGP H-pattern only) -->
                            <ctrl:SectionCard Grid.Column="1" Title="{x:Static res:Strings.Section_Calibration}"
                                              Subtitle="{x:Static res:Strings.Subtitle_ShifterCalibrate}"
                                              Icon="{StaticResource IconCal}"
                                              AccentBrush="{StaticResource RedBrush}" Margin="7,0,0,14">
                                <StackPanel Margin="0,4">
                                    <Button x:Name="HgpCalStartButton" Content="{x:Static res:Strings.Button_StartCalibration}" HorizontalAlignment="Left" Click="HgpCalStartButton_Click"/>
                                    <TextBlock x:Name="HgpCalStatus" Style="{StaticResource MutedHintText}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </ctrl:SectionCard>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== SGP SHIFTER TAB (sequential) ==================== -->
            <TabItem x:Name="SgpTab" Header="{x:Static res:Strings.TabHeader_ShifterSgp}" Visibility="Collapsed">
                <TabItem.Resources>
                    <StaticResource x:Key="ToggleOnBrush" ResourceKey="RedToggleOnBrush"/>
                    <SolidColorBrush x:Key="ToggleOnTextBrush" Color="{StaticResource RedColor}"/>
                </TabItem.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel Margin="5">

                        <!-- Shifter settings -->
                        <ctrl:SectionCard Title="{x:Static res:Strings.Section_ShifterSettings}"
                                          Icon="{StaticResource IconShift}"
                                          AccentBrush="{StaticResource RedBrush}" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8">
                                    <TextBlock Text="{x:Static res:Strings.SliderLabel_ReverseDirection}" Style="{StaticResource SliderLabel}"/>
                                    <ctrl:OffOnToggle x:Name="SgpDirectionCheck" VerticalAlignment="Center" Click="SgpDirectionCheck_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8">
                                    <TextBlock Text="{x:Static res:Strings.SliderLabel_ShifterPaddleSync}" Style="{StaticResource SliderLabel}"/>
                                    <ctrl:OffOnToggle x:Name="SgpPaddleSyncCheck" VerticalAlignment="Center" Click="SgpPaddleSyncCheck_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ctrl:SectionCard>

                        <!-- LEDs (SGP sequential only — 2 configurable LEDs) -->
                        <ctrl:SectionCard Title="{x:Static res:Strings.Section_ShifterLeds}"
                                          Subtitle="{x:Static res:Strings.Subtitle_ShifterLeds}"
                                          Icon="{StaticResource IconLed}"
                                          AccentBrush="{StaticResource RedBrush}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Label_ShifterLed1}" Style="{StaticResource SliderLabel}"/>
                                    <ComboBox Grid.Column="1" x:Name="SgpLed1Combo" HorizontalAlignment="Left" Width="170" SelectionChanged="SgpLed1Combo_Changed"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Label_ShifterLed2}" Style="{StaticResource SliderLabel}"/>
                                    <ComboBox Grid.Column="1" x:Name="SgpLed2Combo" HorizontalAlignment="Left" Width="170" SelectionChanged="SgpLed2Combo_Changed"/>
                                </Grid>
                                <Grid Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_ShifterBrightness}" Style="{StaticResource SliderLabel}"/>
                                    <Slider Grid.Column="1" x:Name="SgpBrightnessSlider" Minimum="0" Maximum="10"
                                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="SgpBrightnessSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="SgpBrightnessValue" MinWidth="24"
                                               TextAlignment="Right" VerticalAlignment="Center" Text="10"/>
                                </Grid>
                            </StackPanel>
                        </ctrl:SectionCard>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== HUB TAB ==================== -->
            <TabItem x:Name="HubTab" Header="{x:Static res:Strings.TabHeader_Hub}" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,8">
                    <StackPanel>

                        <ctrl:SectionCard Title="{x:Static res:Strings.Section_UniversalHubPedals}"
                                          Icon="{StaticResource IconPedals}">
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Ellipse x:Name="HubPedalDot" Width="10" Height="10" Fill="Gray"
                                         VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{x:Static res:Strings.Label_PedalsPort}" Style="{StaticResource SliderLabel}"/>
                                <TextBlock x:Name="HubPedalLabel" Text="—"
                                           FontFamily="{StaticResource FontMono}"
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </ctrl:SectionCard>

                        <ctrl:SectionCard Title="{x:Static res:Strings.Section_Accessories}" Icon="{StaticResource IconBolt}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <Ellipse x:Name="HubPort1Dot" Width="10" Height="10" Fill="Gray"
                                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{x:Static res:Strings.Label_Port1}" Style="{StaticResource SliderLabel}"/>
                                    <TextBlock x:Name="HubPort1Label" Text="—"
                                               FontFamily="{StaticResource FontMono}"
                                               Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <Ellipse x:Name="HubPort2Dot" Width="10" Height="10" Fill="Gray"
                                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{x:Static res:Strings.Label_Port2}" Style="{StaticResource SliderLabel}"/>
                                    <TextBlock x:Name="HubPort2Label" Text="—"
                                               FontFamily="{StaticResource FontMono}"
                                               Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <Ellipse x:Name="HubPort3Dot" Width="10" Height="10" Fill="Gray"
                                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{x:Static res:Strings.Label_Port3}" Style="{StaticResource SliderLabel}"/>
                                    <TextBlock x:Name="HubPort3Label" Text="—"
                                               FontFamily="{StaticResource FontMono}"
                                               Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <Ellipse x:Name="HubPort4Dot" Width="10" Height="10" Fill="Gray"
                                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{x:Static res:Strings.Label_Port4}" Style="{StaticResource SliderLabel}"/>
                                    <TextBlock x:Name="HubPort4Label" Text="—"
                                               FontFamily="{StaticResource FontMono}"
                                               Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </ctrl:SectionCard>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== OPTIONS TAB ==================== -->
            <TabItem x:Name="StalksTab" Header="{x:Static res:Strings.TabHeader_Stalks}" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,8">
                    <StackPanel>

                        <!-- Stalk mode (left) · wipers & lights (right), side by side.
                             The tab only shows when stalks are connected, so the status
                             header was dropped. Wipers & lights follows the truck-sim panel. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                        <ctrl:SectionCard Grid.Column="0" Margin="0,0,7,14" Title="{x:Static res:Strings.Section_StalkMode}" Icon="{StaticResource IconShift}">
                            <StackPanel>
                                <ctrl:SegmentedControl x:Name="StalksModeCombo" HorizontalAlignment="Left" Margin="0,4"
                                                       SelectionChanged="StalksModeCombo_Changed">
                                    <ListBoxItem Content="{x:Static res:Strings.Option_StalkButtonBox}"/>
                                    <ListBoxItem Content="{x:Static res:Strings.Option_StalkTruckSim}"/>
                                </ctrl:SegmentedControl>
                                <TextBlock Text="{x:Static res:Strings.Hint_StalksTruckSim}"
                                           Style="{StaticResource MutedHintText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <Grid Margin="0,8,0,0" Visibility="{Binding Visibility, ElementName=StalksTruckSimPanel}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_StalkDebounce}" Style="{StaticResource SliderLabel}"/>
                                    <Slider Grid.Column="1" x:Name="StalksDebounceSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="150" TickFrequency="5" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" ValueChanged="StalksDebounceSlider_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="StalksDebounceValue" Style="{StaticResource SliderValueEditBox}"
                                             Tag="{Binding ElementName=StalksDebounceSlider}"
                                             KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus" Text="20"/>
                                </Grid>
                            </StackPanel>
                        </ctrl:SectionCard>

                            <ctrl:SectionCard Grid.Column="1" Margin="7,0,0,14"
                                          Visibility="{Binding Visibility, ElementName=StalksTruckSimPanel}"
                                          Title="{x:Static res:Strings.Section_StalksWiperSync}"
                                              Subtitle="{x:Static res:Strings.Subtitle_StalksWiperSync}"
                                              Icon="{StaticResource IconShift}">
                                <StackPanel>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_WiperStageCount}" Style="{StaticResource SliderLabel}"/>
                                        <Slider Grid.Column="1" x:Name="StalksWiperStageSlider" Style="{StaticResource SettingSlider}" Minimum="2" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StalksWiperStageSlider_ValueChanged"/>
                                        <TextBox Grid.Column="2" x:Name="StalksWiperStageValue" Style="{StaticResource SliderValueEditBox}"
                                                 Tag="{Binding ElementName=StalksWiperStageSlider}"
                                                 KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus" Text="4"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Label_WiperForwardWraps}" Style="{StaticResource SliderLabel}"/>
                                        <ctrl:OffOnToggle Grid.Column="1" x:Name="StalksWiperWrapToggle"
                                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                                          Checked="StalksWiperWrapToggle_Changed" Unchecked="StalksWiperWrapToggle_Changed"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_LightStageCount}" Style="{StaticResource SliderLabel}"/>
                                        <Slider Grid.Column="1" x:Name="StalksLightStageSlider" Style="{StaticResource SettingSlider}" Minimum="2" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StalksLightStageSlider_ValueChanged"/>
                                        <TextBox Grid.Column="2" x:Name="StalksLightStageValue" Style="{StaticResource SliderValueEditBox}"
                                                 Tag="{Binding ElementName=StalksLightStageSlider}"
                                                 KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus" Text="3"/>
                                    </Grid>
                                    <DockPanel Margin="0,10,0,0">
                                        <Button x:Name="StalksResyncButton" DockPanel.Dock="Left"
                                                Content="{x:Static res:Strings.Button_ResyncStages}"
                                                Click="StalksResyncButton_Click" Padding="14,6"/>
                                        <TextBlock Text="{x:Static res:Strings.Hint_ResyncWipers}"
                                                   Style="{StaticResource MutedHintText}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </DockPanel>
                                </StackPanel>
                            </ctrl:SectionCard>
                        </Grid>

                        <!-- Truck-sim key mapping (visible only in truck-sim mode) -->
                        <StackPanel x:Name="StalksTruckSimPanel" Visibility="Collapsed">
                            <ctrl:SectionCard Title="{x:Static res:Strings.Section_StalksGameKeys}"
                                              Icon="{StaticResource IconShift}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.Label_WiperForwardKey}" Style="{StaticResource SliderLabel}" Margin="0,4"/>
                                    <ctrl:KeyCaptureBox Grid.Row="0" Grid.Column="1" x:Name="StalksWiperFwdKeyBox" Width="140" Margin="0,4" HorizontalAlignment="Left" KeyChanged="StalksGameKey_Changed"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.Label_WiperBackKey}" Style="{StaticResource SliderLabel}" Margin="0,4"/>
                                    <ctrl:KeyCaptureBox Grid.Row="1" Grid.Column="1" x:Name="StalksWiperBackKeyBox" Width="140" Margin="0,4" HorizontalAlignment="Left" KeyChanged="StalksGameKey_Changed"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Strings.Label_LightCycleKey}" Style="{StaticResource SliderLabel}" Margin="0,4"/>
                                    <ctrl:KeyCaptureBox Grid.Row="2" Grid.Column="1" x:Name="StalksLightCycleKeyBox" Width="140" Margin="0,4" HorizontalAlignment="Left" KeyChanged="StalksGameKey_Changed"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static res:Strings.Label_IndicatorLeftKey}" Style="{StaticResource SliderLabel}" Margin="0,4"/>
                                    <ctrl:KeyCaptureBox Grid.Row="3" Grid.Column="1" x:Name="StalksIndLeftKeyBox" Width="140" Margin="0,4" HorizontalAlignment="Left" KeyChanged="StalksGameKey_Changed"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static res:Strings.Label_IndicatorRightKey}" Style="{StaticResource SliderLabel}" Margin="0,4"/>
                                    <ctrl:KeyCaptureBox Grid.Row="4" Grid.Column="1" x:Name="StalksIndRightKeyBox" Width="140" Margin="0,4" HorizontalAlignment="Left" KeyChanged="StalksGameKey_Changed"/>
                                </Grid>
                            </ctrl:SectionCard>
                            <ctrl:SectionCard Title="{x:Static res:Strings.Section_StalksIndicators}"
                                              Icon="{StaticResource IconShift}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_IndicatorMinBlink}" Style="{StaticResource SliderLabel}"/>
                                    <Slider Grid.Column="1" x:Name="StalksIndMinBlinkSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StalksIndMinBlinkSlider_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="StalksIndMinBlinkValue" Style="{StaticResource SliderValueEditBox}"
                                             Tag="{Binding ElementName=StalksIndMinBlinkSlider}"
                                             KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus" Text="3"/>
                                </Grid>
                            </ctrl:SectionCard>
                            <ctrl:SectionCard Title="{x:Static res:Strings.Section_StalksKeyMapping}"
                                              Subtitle="{x:Static res:Strings.Subtitle_StalksInteractiveMap}"
                                              Icon="{StaticResource IconShift}">
                                <StackPanel>
                                    <TextBlock x:Name="StalksLastPressedLabel"
                                               Style="{StaticResource MutedHintText}" Margin="0,0,0,8"/>
                                    <Button x:Name="StalksLoadDefaultsButton"
                                            Content="{x:Static res:Strings.Button_LoadEts2Defaults}"
                                            Click="StalksLoadDefaultsButton_Click"
                                            HorizontalAlignment="Left" Padding="14,6" Margin="0,0,0,10"/>
                                    <ItemsControl x:Name="StalksButtonList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="#3A3A3A"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                                            <Setter Property="Fill" Value="LimeGreen"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                                   Style="{StaticResource SliderLabel}"/>
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="1" Margin="4,1"
                                                              ItemsSource="{Binding Options}"
                                                              SelectedItem="{Binding Selected, Mode=TwoWay}"/>
                                                    <ctrl:KeyCaptureBox Grid.Column="2" Width="120" Margin="4,1"
                                                                        KeyCode="{Binding KeyCode, Mode=TwoWay}"
                                                                        Visibility="{Binding ShowsKeyCapture, Converter={StaticResource BoolToVisibility}}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ctrl:SectionCard>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== IMPORT TAB ==================== -->
            <!-- Content is the PitHouseImportControl, instantiated in code-behind
                 and assigned to ImportTab.Content. Done in code rather than as a
                 named XAML element because a generated typed field of
                 MozaPlugin.UI.Import.* collides with the MozaPlugin class name. -->
            <TabItem x:Name="ImportTab" Header="{x:Static res:Strings.TabHeader_Import}"/>


            <TabItem x:Name="OptionsTab" Header="{x:Static res:Strings.TabHeader_Options}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,8">
                    <!-- Every row is a label/control Grid whose label column joins a
                         SharedSizeGroup: OptLabelL for left-column cards (Settings,
                         Device definitions), OptLabelR for right-column cards (Language, SDK,
                         Updates), so controls line up down each column at the
                         widest label instead of drifting with each label's length. -->
                    <StackPanel Grid.IsSharedSizeScope="True">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ctrl:SectionCard Grid.Column="0" Margin="0,0,7,14"
                                              Title="{x:Static res:Strings.Section_Settings}" Icon="{StaticResource IconBolt}">
                                <StackPanel>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="OptLabelL"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static res:Strings.SliderLabel_ApplyProfileOnLaunch}" Style="{StaticResource SliderLabel}"/>
                                        <ctrl:OffOnToggle Grid.Column="1" x:Name="AutoApplyProfileCheck" VerticalAlignment="Center"
                                                  Checked="AutoApplyProfileCheck_Changed" Unchecked="AutoApplyProfileCheck_Changed"/>
                                    </Grid>
                                    <!-- Items are built from MainTabs in code (InitDefaultTabCombo). -->
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="OptLabelL"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static res:Strings.SliderLabel_DefaultTab}" Style="{StaticResource SliderLabel}"/>
                                        <ComboBox Grid.Column="1" x:Name="DefaultTabCombo" Width="200" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  SelectionChanged="DefaultTabCombo_Changed"/>
                                    </Grid>
                                    <!-- Status line (firmware note) is long and wraps under the selector. -->
                                    <Grid x:Name="WheelbaseLfeSourceRow" Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="OptLabelL"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{x:Static res:Strings.SliderLabel_WheelbaseLfeSource}" Style="{StaticResource SliderLabel}"
                                                   VerticalAlignment="Center"/>
                                        <ctrl:SegmentedControl x:Name="WheelbaseLfeSourceCombo" Grid.Column="1"
                                                               VerticalAlignment="Center" HorizontalAlignment="Left"
                                                               SelectionChanged="WheelbaseLfeSource_Changed">
                                            <ListBoxItem Content="{x:Static res:Strings.Option_WheelbaseLfeSourcePlugin}"/>
                                            <ListBoxItem Content="{x:Static res:Strings.Option_WheelbaseLfeSourceShakeIt}"/>
                                        </ctrl:SegmentedControl>
                                        <TextBlock x:Name="WheelbaseLfeSourceStatusText" Text="" Grid.Row="1" Grid.Column="1" Visibility="Collapsed"
                                                   Style="{StaticResource MutedHintText}"
                                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </Grid>
                                    <!-- What drives the S12: the plugin's S12 tab, or ShakeIt
                                         as one device per pedal / one combined device. -->
                                    <Grid x:Name="PedalHapticsSourceRow" Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="OptLabelL"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{x:Static res:Strings.SliderLabel_PedalHapticsSource}" Style="{StaticResource SliderLabel}"
                                                   VerticalAlignment="Center"/>
                                        <ctrl:SegmentedControl x:Name="PedalHapticsSourceCombo" Grid.Column="1"
                                                               VerticalAlignment="Center" HorizontalAlignment="Left"
                                                               SelectionChanged="PedalHapticsSource_Changed">
                                            <ListBoxItem Content="{x:Static res:Strings.Option_PedalHapticsSourcePlugin}"/>
                                            <ListBoxItem x:Name="PedalHapticsSourceShakeItItem" Content="{x:Static res:Strings.Option_PedalHapticsSourceShakeIt}"/>
                                            <ListBoxItem x:Name="PedalHapticsSourceCombinedItem" Content="{x:Static res:Strings.Option_PedalHapticsSourceCombined}"/>
                                        </ctrl:SegmentedControl>
                                        <TextBlock x:Name="PedalHapticsSourceStatusText" Text="" Grid.Row="1" Grid.Column="1" Visibility="Collapsed"
                                                   Style="{StaticResource MutedHintText}"
                                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </Grid>
                                    <!-- What drives the mBooster vibrations: the plugin's mBooster
                                         tab, or ShakeIt as one device with a channel per pedal role. -->
                                    <Grid x:Name="MBoosterSourceRow" Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="OptLabelL"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{x:Static res:Strings.SliderLabel_MBoosterSource}" Style="{StaticResource SliderLabel}"
                                                   VerticalAlignment="Center"/>
                                        <ctrl:SegmentedControl x:Name="MBoosterSourceCombo" Grid.Column="1"
                                                               VerticalAlignment="Center" HorizontalAlignment="Left"
                                                               SelectionChanged="MBoosterSource_Changed">
                                            <ListBoxItem Content="{x:Static res:Strings.Option_MBoosterSourcePlugin}"/>
                                            <ListBoxItem x:Name="MBoosterSourceShakeItItem" Content="{x:Static res:Strings.Option_MBoosterSourceShakeIt}"/>
                                        </ctrl:SegmentedControl>
                                        <TextBlock x:Name="MBoosterSourceStatusText" Text="" Grid.Row="1" Grid.Column="1" Visibility="Collapsed"
                                                   Style="{StaticResource MutedHintText}"
                                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </Grid>
                                    <!-- Wheelbase compat mode (main dev 0x12, group 0x1F cmd 19/23).
                                         Persistent base-side state, read back from the device
                                         rather than stored in settings — so the toggle shows what
                                         the base actually holds, including a value PitHouse set. -->
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="OptLabelL"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static res:Strings.SliderLabel_ForzaCompatMode}" Style="{StaticResource SliderLabel}"/>
                                        <ctrl:OffOnToggle Grid.Column="1" x:Name="ForzaCompatCheck" VerticalAlignment="Center"
                                                  Checked="ForzaCompatCheck_Changed" Unchecked="ForzaCompatCheck_Changed"/>
                                    </Grid>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="OptLabelL"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static res:Strings.SliderLabel_Ab9Detection}" Style="{StaticResource SliderLabel}"/>
                                        <ctrl:OffOnToggle Grid.Column="1" x:Name="Ab9DetectionCheck" VerticalAlignment="Center"
                                                  Checked="Ab9DetectionCheck_Changed" Unchecked="Ab9DetectionCheck_Changed"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="OptLabelL"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_KeepaliveTimeout}" Style="{StaticResource SliderLabel}"/>
                                        <Slider Grid.Column="1" x:Name="KeepaliveTimeoutSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="300" TickFrequency="5" SmallChange="1" LargeChange="15" IsSnapToTickEnabled="True" ValueChanged="KeepaliveTimeoutSlider_ValueChanged"/>
                                        <TextBox Grid.Column="2" x:Name="KeepaliveTimeoutValue" Style="{StaticResource SliderValueEditBox}"
                                                 Tag="{Binding ElementName=KeepaliveTimeoutSlider}"
                                                 KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                 Text="45 s"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                   Text="{x:Static res:Strings.Hint_KeepaliveTimeout}"
                                                   Style="{StaticResource MutedHintText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </ctrl:SectionCard>

                            <!-- Language + SDK stacked beside Settings; SDK fills the
                                 remaining height so both columns end level. -->
                            <Grid Grid.Column="1" Margin="7,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <ctrl:SectionCard Grid.Row="0" Margin="0,0,0,14"
                                                  Title="{x:Static res:Strings.Section_Language}" Icon="{StaticResource IconBolt}">
                                    <StackPanel>
                                        <Grid Margin="0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="OptLabelR"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{x:Static res:Strings.SliderLabel_Language}" Style="{StaticResource SliderLabel}"/>
                                            <ComboBox Grid.Column="1" x:Name="LanguageCombo" Width="200" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      SelectionChanged="LanguageCombo_Changed"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static res:Strings.Hint_LanguageChangeRestart}"
                                                       Style="{StaticResource MutedHintText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>
                                </ctrl:SectionCard>

                                <ctrl:SectionCard Grid.Row="1" Margin="0,0,0,14"
                                                  Title="{x:Static res:Strings.Section_Sdk}" Icon="{StaticResource IconBolt}">
                                    <StackPanel>
                                        <Grid Margin="0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="OptLabelR"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{x:Static res:Strings.SliderLabel_EnableCoapServer}" Style="{StaticResource SliderLabel}"/>
                                            <ctrl:OffOnToggle Grid.Column="1" x:Name="SdkEmulationEnabledCheck" VerticalAlignment="Center"
                                                      Checked="SdkEmulationEnabledCheck_Changed" Unchecked="SdkEmulationEnabledCheck_Changed"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SdkCoapStatusText" Text=""
                                                       Style="{StaticResource MutedHintText}"
                                                       FontFamily="{StaticResource FontMono}"
                                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid Margin="0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="OptLabelR"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Static res:Strings.SliderLabel_EnableUdpControl}" Style="{StaticResource SliderLabel}"/>
                                            <ctrl:OffOnToggle Grid.Column="1" x:Name="UdpControlEnabledCheck" VerticalAlignment="Center"
                                                      Checked="UdpControlEnabledCheck_Changed" Unchecked="UdpControlEnabledCheck_Changed"/>
                                        </Grid>
                                    </StackPanel>
                                </ctrl:SectionCard>
                            </Grid>
                        </Grid>

                        <!-- ============ Updates ============
                             Owned by the SettingsControl.UpdateBanner.cs partial.
                             Left half: CHANGELOG.md of the selected channel's latest
                             release. Right half: the update banner (collapsed until a
                             newer release is detected) above the always-visible
                             settings rows; these sit in the right column, so their
                             labels join OptLabelR. -->
                        <ctrl:SectionCard x:Name="UpdatesSection"
                                          Title="{x:Static res:Strings.Section_Updates}"
                                          Subtitle="{x:Static res:Strings.Subtitle_Updates}"
                                          Icon="{StaticResource IconRefresh}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Height tracks the settings column, with a floor so it stays readable. -->
                                <Border Grid.Column="0" Margin="0,0,10,0" MinHeight="300"
                                        Height="{Binding ActualHeight, ElementName=UpdatesSettingsPanel}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        Background="{StaticResource BgDeepBrush}"
                                        CornerRadius="4" Padding="2">
                                    <RichTextBox x:Name="ChangelogBox"
                                                 IsReadOnly="True"
                                                 IsDocumentEnabled="True"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{StaticResource TextDimBrush}"
                                                 FontFamily="{StaticResource FontUi}"
                                                 FontSize="12"
                                                 Padding="8"
                                                 VerticalScrollBarVisibility="Auto"/>
                                </Border>
                                <StackPanel x:Name="UpdatesSettingsPanel" Grid.Column="1" Margin="10,0,0,0"
                                            VerticalAlignment="Top">
                                    <Border x:Name="UpdateBannerBorder"
                                            Visibility="Collapsed"
                                            BorderBrush="{StaticResource CyanBrush}"
                                            BorderThickness="1"
                                            Background="{StaticResource BgDeepBrush}"
                                            Padding="12,10"
                                            Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock x:Name="UpdateBannerText"
                                                       FontFamily="{StaticResource FontUi}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource CyanBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8"/>
                                            <TextBlock x:Name="UpdateBannerProgressText"
                                                       Style="{StaticResource MutedHintText}"
                                                       TextWrapping="Wrap"
                                                       Visibility="Collapsed"
                                                       Margin="0,0,0,8"/>
                                            <WrapPanel>
                                                <Button x:Name="UpdateBannerInstallButton"
                                                        Content="{x:Static res:Strings.Button_InstallUpdate}"
                                                        Click="UpdateBanner_Install_Click"
                                                        Margin="0,0,8,6"/>
                                                <Button x:Name="UpdateBannerRestartButton"
                                                        Content="{x:Static res:Strings.Button_RestartSimHub}"
                                                        Click="UpdateBanner_Restart_Click"
                                                        Visibility="Collapsed"
                                                        Margin="0,0,8,6"/>
                                                <Button x:Name="UpdateBannerOpenButton"
                                                        Content="{x:Static res:Strings.Button_OpenReleaseNotes}"
                                                        Click="UpdateBanner_OpenNotes_Click"
                                                        Margin="0,0,8,6"/>
                                                <Button x:Name="UpdateBannerSkipButton"
                                                        Content="{x:Static res:Strings.Button_SkipThisVersion}"
                                                        Click="UpdateBanner_Skip_Click"
                                                        Margin="0,0,8,6"/>
                                                <Button x:Name="UpdateBannerDismissButton"
                                                        Content="{x:Static res:Strings.Button_DismissUpdate}"
                                                        Click="UpdateBanner_Dismiss_Click"
                                                        Margin="0,0,0,6"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="OptLabelR"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static res:Strings.Label_CheckForUpdates}" Style="{StaticResource SliderLabel}"/>
                                        <ctrl:OffOnToggle Grid.Column="1" x:Name="UpdateCheckEnabledToggle" VerticalAlignment="Center"
                                                  Click="UpdateCheckEnabled_Click"/>
                                    </Grid>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="OptLabelR"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static res:Strings.Label_ReleaseChannel}" Style="{StaticResource SliderLabel}"/>
                                        <ComboBox Grid.Column="1" x:Name="UpdateChannelCombo"
                                                  MinWidth="160" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  SelectionChanged="UpdateChannelCombo_SelectionChanged"
                                                  DropDownOpened="UpdateChannelCombo_DropDownOpened"/>
                                    </Grid>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="OptLabelR"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static res:Strings.Label_FollowBetaChannel}" Style="{StaticResource SliderLabel}"/>
                                        <ctrl:OffOnToggle Grid.Column="1" x:Name="FollowBetaToggle" VerticalAlignment="Center"
                                                  Click="FollowBeta_Click"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                                        <Button x:Name="UpdateCheckNowButton"
                                                Content="{x:Static res:Strings.Button_CheckNow}"
                                                Click="UpdateCheckNow_Click"
                                                Margin="0,0,12,0"/>
                                        <TextBlock x:Name="UpdateLastCheckedText"
                                                   Style="{StaticResource MutedHintText}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ctrl:SectionCard>

                        <!-- Hidden: dashboard upload/download UI collapsed while the feature is
                             in development. Runtime values are forced off in MozaPlugin; the
                             upload/download scaffolding is intentionally preserved. It kept its
                             own panel when the enclosing Dashboard-telemetry card (which only
                             ever showed the retired firmware-era override) was removed. -->
                        <StackPanel Visibility="Collapsed">
                            <ctrl:OffOnToggle x:Name="UploadDashboardCheck" Content="{x:Static res:Strings.Label_UploadDashboardOnConnect}"
                                      Margin="0,8,0,4" Checked="UploadDashboard_Changed" Unchecked="UploadDashboard_Changed"/>
                            <ctrl:OffOnToggle x:Name="DownloadDashboardCheck" Content="{x:Static res:Strings.Label_DownloadDashboardsFromWheel}"
                                      Margin="0,8,0,4" Checked="DownloadDashboard_Changed" Unchecked="DownloadDashboard_Changed"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ctrl:SectionCard Grid.Column="0" Margin="0,0,7,14"
                                              Title="{x:Static res:Strings.Section_DeviceDefinitions}" Icon="{StaticResource IconRefresh}">
                                <StackPanel>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="OptLabelL"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static res:Strings.SliderLabel_ShowAllTabs}" Style="{StaticResource SliderLabel}"/>
                                        <ctrl:OffOnToggle Grid.Column="1" x:Name="ShowAllTabsCheck" VerticalAlignment="Center"
                                                  Checked="ShowAllTabsCheck_Changed" Unchecked="ShowAllTabsCheck_Changed"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="RedeployDefinitionsButton" Content="{x:Static res:Strings.Button_RedeployDefinitions}"
                                                Click="RedeployDefinitionsButton_Click" MinWidth="120"/>
                                        <TextBlock x:Name="RedeployDefinitionsStatusText" Text=""
                                                   Style="{StaticResource MutedHintText}"
                                                   VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </ctrl:SectionCard>

                            <ctrl:SectionCard Grid.Column="1" Margin="7,0,0,14"
                                              Title="{x:Static res:Strings.Section_Reset}" Icon="{StaticResource IconAlert}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8">
                                        <Button x:Name="ClearAllSettingsButton" Content="{x:Static res:Strings.Button_ClearAllSettings}"
                                                Style="{StaticResource MozaButtonDanger}"
                                                Click="ClearAllSettingsButton_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Static res:Strings.Hint_ClearAllSettingsWarning}"
                                               Style="{StaticResource MutedHintText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ctrl:SectionCard>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="HelpTab" Header="{x:Static res:Strings.TabHeader_Help}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,8">
                    <StackPanel>

                        <!-- ============ About / Project links + Guides ============ -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ctrl:SectionCard Grid.Column="0"
                                              Title="{x:Static res:Strings.Section_About}"
                                              Icon="{StaticResource IconShield}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{x:Static res:Strings.Label_AzomTitle}"
                                                       FontFamily="{StaticResource FontUi}"
                                                       FontSize="22" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock x:Name="AboutVersionText"
                                                       Text="{x:Static res:Strings.Label_VersionPlaceholder}"
                                                       FontFamily="{StaticResource FontMono}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource CyanBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock TextWrapping="Wrap"
                                               Style="{StaticResource MutedHintText}"
                                               Margin="0,0,0,16"
                                               Text="{x:Static res:Strings.Hint_AboutDescription}"/>
                                    <TextBlock TextWrapping="Wrap"
                                               Style="{StaticResource MutedHintText}"
                                               FontStyle="Italic"
                                               Foreground="{StaticResource TextDimBrush}"
                                               Margin="0,0,0,16"
                                               Text="{x:Static res:Strings.Hint_ThanksToTesters}"/>
                                    <TextBlock TextWrapping="Wrap"
                                               Style="{StaticResource MutedHintText}"
                                               Margin="0,0,0,12"
                                               Text="{x:Static res:Strings.Hint_SponsorshipsAppreciated}"/>
                                    <WrapPanel Margin="0,0,0,-8">
                                        <Button Content="{x:Static res:Strings.Button_Github}"
                                                Click="AboutGitHubButton_Click"
                                                Margin="0,0,8,8"
                                                ToolTip="{x:Static res:Strings.Tooltip_Github}"/>
                                        <Button Content="{x:Static res:Strings.Button_JoinDiscord}"
                                                Click="AboutDiscordButton_Click"
                                                Margin="0,0,8,8"
                                                ToolTip="{x:Static res:Strings.Tooltip_JoinDiscord}"/>
                                        <Button Content="{x:Static res:Strings.Button_SponsorDevelopment}"
                                                Click="AboutSponsorButton_Click"
                                                Foreground="{StaticResource GreenBrush}"
                                                BorderBrush="#6639FF88"
                                                Margin="0,0,8,8"
                                                ToolTip="{x:Static res:Strings.Tooltip_Sponsor}"/>
                                        <Button Content="{x:Static res:Strings.Button_Kofi}"
                                                Click="AboutKofiButton_Click"
                                                Foreground="{StaticResource RedBrush}"
                                                BorderBrush="#6639FF88"
                                                Margin="0,0,8,8"
                                                ToolTip="{x:Static res:Strings.Tooltip_Kofi}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </ctrl:SectionCard>

                            <ctrl:SectionCard Grid.Column="2"
                                              Title="{x:Static res:Strings.Section_Guides}"
                                              Icon="{StaticResource IconBook}">
                                <StackPanel>
                                    <!-- Filled from AboutGuides (SettingsControl.About.cs). -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel x:Name="GuidesLeftColumn" Grid.Column="0"/>
                                        <StackPanel x:Name="GuidesRightColumn" Grid.Column="2"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{x:Static res:Strings.Link_AllGuides}"
                                                Click="AboutGuidesIndexButton_Click"
                                                ToolTip="giant.orth.cc/guides"/>
                                    </StackPanel>
                                </StackPanel>
                            </ctrl:SectionCard>
                        </Grid>

                        <!-- Bandwidth visualization was moved to the Base tab's live header
                             (next to the temperature graph) as a single dual-line sparkline. -->

                        <ctrl:SectionCard Title="{x:Static res:Strings.Section_BugReport}"
                                          Icon="{StaticResource IconDiag}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.Label_BugReportDescription}"
                                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="BugReportDescriptionBox" Style="{StaticResource LfeNameBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MaxLength="2000"
                                         MinHeight="80" MaxHeight="160"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         ToolTip="{x:Static res:Strings.Placeholder_BugReportDescription}"/>
                                <TextBlock Text="{x:Static res:Strings.Label_BugReportContact}"
                                           Foreground="{StaticResource TextBrush}" Margin="0,10,0,4"/>
                                <TextBox x:Name="BugReportContactBox" Style="{StaticResource LfeNameBox}" MaxLength="200"/>
                                <TextBlock Text="{x:Static res:Strings.Hint_BugReportConsent}"
                                           Style="{StaticResource MutedHintText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="SubmitBugReportButton" Content="{x:Static res:Strings.Button_SubmitBugReport}"
                                            Style="{StaticResource MozaButtonPrimary}" Click="SubmitBugReport_Click"/>
                                    <Button x:Name="SerialCaptureExportButton" Content="{x:Static res:Strings.Button_ExportBundle}"
                                            Click="SerialCaptureExport_Click" Margin="8,0,0,0"
                                            ToolTip="{x:Static res:Strings.Tooltip_ExportBundle}"/>
                                    <Button x:Name="CopyBugReportRefButton" Content="{x:Static res:Strings.Button_CopyReference}"
                                            Click="CopyBugReportRef_Click" Margin="8,0,0,0"
                                            Visibility="Collapsed"/>
                                </StackPanel>
                                <!-- Read-only TextBox rather than a TextBlock: the
                                     result line carries the ticket reference (and
                                     the export path a file path), which the user
                                     has to be able to select and copy. Own row so
                                     a long message wraps instead of clipping. -->
                                <TextBox x:Name="BugReportStatusText"
                                         Visibility="Collapsed" Margin="0,10,0,0"
                                         IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         Foreground="{StaticResource TextFaintBrush}"
                                         FontFamily="{StaticResource FontUi}" FontSize="13"
                                         TextWrapping="Wrap"/>
                            </StackPanel>
                        </ctrl:SectionCard>

                        <!-- ============ Full Diagnostic Report (expandable) ============ -->
                        <ctrl:SectionCard Title="{x:Static res:Strings.Section_FullDiagReport}"
                                          Subtitle="{x:Static res:Strings.Subtitle_FullDiagReport}"
                                          Icon="{StaticResource IconDiag}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="FullDiagToggleButton" Content="{x:Static res:Strings.Button_Expand}"
                                            Click="FullDiagToggle_Click" Margin="0,0,8,0"/>
                                    <Button Content="{x:Static res:Strings.Button_CopyAll}" Click="DiagCopyAll_Click"
                                            Margin="0,0,8,0"/>
                                    <TextBlock x:Name="FullDiagSummaryText"
                                               Style="{StaticResource MutedHintText}"
                                               VerticalAlignment="Center"
                                               Text="{x:Static res:Strings.Hint_ClickExpandToRender}"/>
                                </StackPanel>
                                <TextBox x:Name="FullDiagReportBox"
                                         FontFamily="{StaticResource FontMono}" FontSize="11"
                                         Foreground="{StaticResource TextDimBrush}"
                                         Background="{StaticResource BgDeepBrush}"
                                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                         IsReadOnly="True" TextWrapping="NoWrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         MaxHeight="400" Padding="10"
                                         Visibility="Collapsed"/>
                            </StackPanel>
                        </ctrl:SectionCard>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</UserControl>
