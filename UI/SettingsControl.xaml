                                    <Button Content="{x:Static res:Strings.Label_Import}" Margin="0,0,8,0" Padding="12,5" Click="BaseLfePresetImport_Click"/>
                                    <Button Content="{x:Static res:Strings.Label_Export}" Padding="12,5" Click="BaseLfePresetExport_Click"/>
