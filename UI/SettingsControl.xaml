                                        <TextBox Grid.Column="1" x:Name="BaseLfeEngineFrequencyValue" Width="58" Style="{StaticResource SliderValueEditBox}" Tag="{Binding ElementName=BaseLfeEngineFrequencySlider}" KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus" Text="100"/>
