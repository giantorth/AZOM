                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ctrl:SectionCard Grid.Column="0" Title="{x:Static res:Strings.Section_Protection}"
                                              Icon="{StaticResource IconShield}" Margin="0,0,7,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8">
                                        <TextBlock Text="{x:Static res:Strings.SliderLabel_HandsOffProtection}" Style="{StaticResource SliderLabel}"/>
                                        <ctrl:OffOnToggle x:Name="ProtectionCheck" VerticalAlignment="Center" Click="ProtectionCheck_Click"/>
                                    </StackPanel>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_SteeringWheelInertia}" Style="{StaticResource SliderLabel}"/>
                                        <Slider Grid.Column="1" x:Name="NaturalInertiaSlider" Style="{StaticResource SettingSlider}" Minimum="100" Maximum="4000" TickFrequency="50" ValueChanged="NaturalInertiaSlider_ValueChanged"/>
                                        <TextBox Grid.Column="2" x:Name="NaturalInertiaValue" Style="{StaticResource SliderValueEditBox}"
                                                 Tag="{Binding ElementName=NaturalInertiaSlider}"
                                                 KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                 Text="1100"/>
                                    </Grid>
                                </StackPanel>
                            </ctrl:SectionCard>

                            <ctrl:SectionCard Grid.Column="1" Title="{x:Static res:Strings.Section_SoftLimit}"
                                              Icon="{StaticResource IconLimit}" Margin="7,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_SoftLimitStrength}" Style="{StaticResource SliderLabel}"/>
                                        <!-- cmd 0x1B: Soft 50 / Middle 75 / Hard 100 (% of max) -->
                                        <ctrl:SegmentedControl Grid.Column="1" x:Name="SoftLimitStrengthCombo" HorizontalAlignment="Left"
                                                               VerticalAlignment="Center" SelectionChanged="SoftLimitStrengthCombo_Changed">
                                            <ListBoxItem Content="{x:Static res:Strings.Option_SoftLimitSoft}"/>
                                            <ListBoxItem Content="{x:Static res:Strings.Option_SoftLimitMiddle}"/>
                                            <ListBoxItem Content="{x:Static res:Strings.Option_SoftLimitHard}"/>
                                        </ctrl:SegmentedControl>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_Stiffness}" Style="{StaticResource SliderLabel}"/>
                                        <Slider Grid.Column="1" x:Name="SoftLimitStiffnessSlider" Style="{StaticResource SettingSlider}" Minimum="1" Maximum="10" TickFrequency="1" ValueChanged="SoftLimitStiffnessSlider_ValueChanged"/>
                                        <TextBox Grid.Column="2" x:Name="SoftLimitStiffnessValue" Style="{StaticResource SliderValueEditBox}"
                                                 Tag="{Binding ElementName=SoftLimitStiffnessSlider}"
                                                 KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                 Text="5"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8">
                                        <TextBlock Text="{x:Static res:Strings.SliderLabel_RetainGameFfb}" Style="{StaticResource SliderLabel}"/>
                                        <ctrl:OffOnToggle x:Name="SoftLimitRetainCheck" VerticalAlignment="Center" Click="SoftLimitRetainCheck_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </ctrl:SectionCard>
                        </Grid>

                        <!-- FFB Equalizer + Output Curve sit side-by-side: same widget
                             shape (a node graph with a row of preset buttons), benefit
                             from being readable together. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ctrl:SectionCard x:Name="FfbEqCard" Grid.Column="0" Title="{x:Static res:Strings.Section_FfbEqualizer}"
                                              Subtitle="{x:Static res:Strings.Subtitle_FfbEqualizer}"
                                              Icon="{StaticResource IconEq}" Margin="0,0,7,14">
                                <StackPanel>
                                    <ctrl:MozaCurveEditor x:Name="FfbEqualizer"
                                                          Style="{StaticResource MozaEqualizerLineStyle}"
                                                          Height="280"/>
                                    <!-- 10-band variant (fw >= 1.2.10.10) — ApplyEqBandMode swaps
                                         the two editors' Visibility on the refresh tick. -->
                                    <ctrl:MozaCurveEditor x:Name="FfbEqualizer10"
                                                          Style="{StaticResource MozaEqualizerLineStyle10}"
                                                          Height="280" Visibility="Collapsed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="{x:Static res:Strings.Label_EqSensitivity}"
                                                   Style="{StaticResource KvKeyText}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <!-- Selection is derived from the 0x0C + EQ tuple each refresh tick;
                                             the last item is the "custom" state and isn't clickable. -->
                                        <ctrl:SegmentedControl x:Name="EqSensitivitySelector" SelectionChanged="EqSensitivity_Changed">
                                            <ListBoxItem Content="0"  Padding="6,6" MinWidth="28"/>
                                            <ListBoxItem Content="1"  Padding="6,6" MinWidth="28"/>
                                            <ListBoxItem Content="2"  Padding="6,6" MinWidth="28"/>
                                            <ListBoxItem Content="3"  Padding="6,6" MinWidth="28"/>
                                            <ListBoxItem Content="4"  Padding="6,6" MinWidth="28"/>
                                            <ListBoxItem Content="5"  Padding="6,6" MinWidth="28"/>
                                            <ListBoxItem Content="6"  Padding="6,6" MinWidth="28"/>
                                            <ListBoxItem Content="7"  Padding="6,6" MinWidth="28"/>
                                            <ListBoxItem Content="8"  Padding="6,6" MinWidth="28"/>
                                            <ListBoxItem Content="9"  Padding="6,6" MinWidth="28"/>
                                            <ListBoxItem Content="10" Padding="6,6" MinWidth="28"/>
                                            <ListBoxItem Padding="6,6" MinWidth="28" IsHitTestVisible="False" Focusable="False">
                                                <Path Data="{StaticResource IconEqCustom}"
                                                      Stretch="Uniform" Width="14" Height="14"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                      StrokeThickness="1.5" Fill="{x:Null}"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"/>
                                            </ListBoxItem>
                                        </ctrl:SegmentedControl>
                                    </StackPanel>
                                </StackPanel>
                            </ctrl:SectionCard>

                            <ctrl:SectionCard Grid.Column="1" Title="{x:Static res:Strings.Section_FfbOutputCurve}"
                                              Subtitle="{x:Static res:Strings.Subtitle_FfbOutputCurve}"
                                              Icon="{StaticResource IconCurve}"
                                              AccentBrush="{StaticResource GreenBrush}" Margin="7,0,0,14">
                                <StackPanel>
                                    <ctrl:MozaCurveEditor x:Name="FfbCurveEditor" Height="280"
                                                          AllowHorizontalDrag="True" LockLastNodeX="True"
                                                          AccentBrush="{StaticResource GreenBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{x:Static res:Strings.Button_Linear}" Margin="0,0,8,0" Click="FfbCurvePreset_Linear"/>
                                        <Button Content="{x:Static res:Strings.Button_SCurve}" Margin="0,0,8,0" Click="FfbCurvePreset_SCurve"/>
                                        <Button Content="{x:Static res:Strings.Button_Exponential}" Margin="0,0,8,0" Click="FfbCurvePreset_Exponential"/>
                                        <Button Content="{x:Static res:Strings.Button_Parabolic}" Click="FfbCurvePreset_Parabolic"/>
                                    </StackPanel>
                                    <!-- PitHouse "FFB center deadzone compensation": no register of
                                         its own, rewrites curve points y1-y4 (see ApplyDeadzoneCompensation). -->
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SliderLabel_DeadzoneCompensation}" Style="{StaticResource SliderLabel}"/>
                                        <Slider Grid.Column="1" x:Name="DeadzoneCompSlider" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="10" TickFrequency="1" ValueChanged="DeadzoneCompSlider_ValueChanged"/>
                                        <TextBox Grid.Column="2" x:Name="DeadzoneCompValue" Style="{StaticResource SliderValueEditBox}"
                                                 Tag="{Binding ElementName=DeadzoneCompSlider}"
                                                 KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                 Text="0"/>
                                    </Grid>
                                </StackPanel>
                            </ctrl:SectionCard>
                        </Grid>

                        <!-- Data-store sliders, driven by the editors above (visibility
                             collapsed so they don't render but their x:Name + ValueChanged
                             still resolve through the existing two-way bindings). -->
                        <StackPanel Visibility="Collapsed">
                            <Slider x:Name="Eq1Slider" Minimum="0" Maximum="400" TickFrequency="1" ValueChanged="Eq1Slider_ValueChanged"/>
                            <Slider x:Name="Eq2Slider" Minimum="0" Maximum="400" TickFrequency="1" ValueChanged="Eq2Slider_ValueChanged"/>
                            <Slider x:Name="Eq3Slider" Minimum="0" Maximum="400" TickFrequency="1" ValueChanged="Eq3Slider_ValueChanged"/>
                            <Slider x:Name="Eq4Slider" Minimum="0" Maximum="400" TickFrequency="1" ValueChanged="Eq4Slider_ValueChanged"/>
                            <Slider x:Name="Eq5Slider" Minimum="0" Maximum="400" TickFrequency="1" ValueChanged="Eq5Slider_ValueChanged"/>
                            <Slider x:Name="Eq6Slider" Minimum="0" Maximum="400" TickFrequency="1" ValueChanged="Eq6Slider_ValueChanged"/>
                            <Slider x:Name="Eq7Slider" Minimum="0" Maximum="500" TickFrequency="1" ValueChanged="Eq7Slider_ValueChanged"/>
                            <Slider x:Name="Eq8Slider" Minimum="0" Maximum="500" TickFrequency="1" ValueChanged="Eq8Slider_ValueChanged"/>
                            <Slider x:Name="Eq9Slider" Minimum="0" Maximum="500" TickFrequency="1" ValueChanged="Eq9Slider_ValueChanged"/>
                            <Slider x:Name="Eq10Slider" Minimum="0" Maximum="500" TickFrequency="1" ValueChanged="Eq10Slider_ValueChanged"/>
                            <Slider x:Name="FfbCurveX1Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="FfbCurveX1Slider_ValueChanged"/>
                            <Slider x:Name="FfbCurveX2Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="FfbCurveX2Slider_ValueChanged"/>
                            <Slider x:Name="FfbCurveX3Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="FfbCurveX3Slider_ValueChanged"/>
                            <Slider x:Name="FfbCurveX4Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="FfbCurveX4Slider_ValueChanged"/>
                            <Slider x:Name="FfbCurveY1Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="FfbCurveY1Slider_ValueChanged"/>
                            <Slider x:Name="FfbCurveY2Slider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="FfbCurveY2Slider_ValueChanged"/>
