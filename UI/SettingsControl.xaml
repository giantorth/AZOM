                                                 KeyDown="SliderValueBox_KeyDown" LostFocus="SliderValueBox_LostFocus"
                                                 Text="120 kph"/>
                                    </Grid>
                                </StackPanel>
                            </ctrl:SectionCard>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Wheelbase LFE effects — own tab (immediately right of Base), shown
                 only on LFE-capable firmware (MozaData.BaseSupportsLfe). A presets box
                 on top, then one box per effect. Content between the GEN markers is
                 generated by tools/rebuild_lfe_card.py. -->
