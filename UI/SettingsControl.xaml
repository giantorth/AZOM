                            </ctrl:SectionCard.Header>
                            <StackPanel>
                                <ComboBox x:Name="BaseLfePresetCombo" Style="{StaticResource MozaCombo}" MinWidth="0" DisplayMemberPath="Name" Margin="0,0,0,8" SelectionChanged="BaseLfePresetCombo_SelectionChanged"/>
