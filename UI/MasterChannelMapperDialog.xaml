<Window x:Class="MozaPlugin.UI.MasterChannelMapperDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MozaPlugin.Resources"
        xmlns:profilescommon="clr-namespace:SimHub.Plugins.ProfilesCommon;assembly=SimHub.Plugins"
        Title="{x:Static res:Strings.Title_MasterChannelDefaults}"
        Width="960" Height="720" MinWidth="640" MinHeight="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource SurfaceOpaqueBrush}"
        TextElement.Foreground="{DynamicResource TextBrush}"
        TextElement.FontFamily="{DynamicResource FontUi}"
        TextElement.FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MozaPlugin;component/Themes/MozaTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MozaPlugin;component/Themes/MozaIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <Style TargetType="Button" BasedOn="{StaticResource MozaButton}"/>
            <Style TargetType="CheckBox" BasedOn="{StaticResource MozaCheckBox}"/>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filter + profile selector + overridden count (data line, no hints) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Center, not the Stretch default: this row is Height="Auto" and the
                 ProfileList beside it is a tall composite (dropdown + New/Clone/Edit/
                 Manage), so a stretching TextBox grows to match it. -->
            <TextBox Grid.Column="0" x:Name="FilterBox"
                     TextChanged="FilterBox_TextChanged"
                     VerticalAlignment="Center"
                     FontFamily="{StaticResource FontMono}"
                     Padding="8,5"
                     Foreground="{StaticResource TextBrush}"
                     Background="{StaticResource BgDeepBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"/>
            <!-- This dialog's OWN profile list — SimHub's ProfileList control bound
                 (via DataContext, in code-behind) to MozaChannelDefaultsStore, a store
                 separate from the device profiles on the Options tab. Gives the
                 dropdown plus New / Clone / Edit / Manage, so these sets are created
                 and named here; switching one has no effect on the device profile.
                 CurrentProfileChanged rebuilds the rows. -->
            <profilescommon:ProfileList Grid.Column="1" x:Name="ProfileSelector"
                                        MinWidth="260" Margin="10,0,0,0"
                                        VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" x:Name="OverriddenCountText"
                       Style="{StaticResource MutedHintText}"
                       FontFamily="{StaticResource FontMono}"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
        </Grid>

        <!-- Static header. Mirrors the row template's column proportions. -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.DataGridHeader_Channel}"
                       Style="{StaticResource MutedHintText}"
                       FontWeight="SemiBold" Padding="10,4"/>
            <TextBlock Grid.Column="1" Text="{x:Static res:Strings.DataGridHeader_SimHubProperty}"
                       Style="{StaticResource MutedHintText}"
                       FontWeight="SemiBold" Padding="10,4"/>
        </Grid>

        <!-- 450+ rows: virtualized with pixel scrolling so the expanding inline
             editor doesn't make item-based scrolling jump. ItemsControl rather
             than ListBox — these rows have no selection concept. -->
        <ItemsControl Grid.Row="2" x:Name="ChannelList"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4">
                        <ScrollViewer CanContentScroll="True" Padding="0,4">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       Padding="10,4"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Url}"
                                                   FontFamily="{StaticResource FontMono}"/>
                                        <TextBlock FontFamily="{StaticResource FontMono}">
                                            <Run Text="{Binding Compression, Mode=OneWay}"/>
                                            <Run Text=" · pkg "/>
                                            <Run Text="{Binding PackageLevel, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <!-- Effective default: current mapping + pencil (pick a
                                 property) + f(x) (NCalc / js: formula) + revert. -->
                            <Grid Grid.Column="1" Margin="10,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding SimHubProperty}"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource FontMono}"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1"
                                        Click="EditMapping_Click"
                                        Tag="{Binding}"
                                        ToolTip="{x:Static res:Strings.Tooltip_EditMapping}"
                                        Width="26" Height="22"
                                        Padding="2" Margin="6,0,0,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Path Data="{StaticResource IconEdit}"
                                          Stretch="Uniform"
                                          Width="14" Height="14"
                                          Stroke="{DynamicResource TextDimBrush}"
                                          StrokeThickness="1.5"
                                          Fill="{x:Null}"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Button>
                                <Button Grid.Column="2"
                                        Click="AdvancedEditMapping_Click"
                                        Tag="{Binding}"
                                        ToolTip="{x:Static res:Strings.Tooltip_EditFormula}"
                                        Width="34" Height="22"
                                        Padding="2" Margin="4,0,0,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <TextBlock Text="𝑓(𝑥)"
                                               FontFamily="Cambria Math, Segoe UI"
                                               FontSize="14"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextDimBrush}"/>
                                </Button>
                                <Button Grid.Column="3"
                                        Click="RevertMapping_Click"
                                        Tag="{Binding}"
                                        ToolTip="{x:Static res:Strings.Tooltip_RevertToDefault}"
                                        Width="26" Height="22"
                                        Padding="2" Margin="4,0,0,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Visibility="{Binding IsOverridden,
                                                    Converter={StaticResource BoolToVisibility}}">
                                    <Path Data="{StaticResource IconRefresh}"
                                          Stretch="Uniform"
                                          Width="14" Height="14"
                                          Stroke="{DynamicResource AmberBrush}"
                                          StrokeThickness="1.5"
                                          Fill="{x:Null}"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Button>
                            </Grid>
                        </Grid>

                        <!-- Inline property picker — visible while row.IsEditing -->
                        <Border Margin="20,4,20,8"
                                Background="{DynamicResource BgCard2Brush}"
                                BorderBrush="{DynamicResource BorderBrightBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10"
                                Visibility="{Binding IsEditing,
                                            Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             x:Name="EditFilterBox"
                                             Text="{Binding EditFilter,
                                                   UpdateSourceTrigger=PropertyChanged,
                                                   Mode=TwoWay}"
                                             FontFamily="{DynamicResource FontMono}"
                                             Padding="8,4"
                                             Foreground="{DynamicResource TextBrush}"
                                             Background="{DynamicResource BgDeepBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}"
                                             BorderThickness="1"/>
                                    <Button Grid.Column="1"
                                            Content="{x:Static res:Strings.Button_Cancel}"
                                            Margin="6,0,0,0"
                                            Click="CancelMapping_Click"
                                            Tag="{Binding}"/>
                                    <Button Grid.Column="2"
                                            Content="{x:Static res:Strings.Button_Ok}"
                                            MinWidth="60"
                                            Margin="6,0,0,0"
                                            Click="CommitMapping_Click"
                                            Tag="{Binding}"/>
                                </Grid>
                                <ListBox ItemsSource="{Binding FilteredProperties}"
                                         SelectedItem="{Binding PendingProperty, Mode=TwoWay}"
                                         MaxHeight="240"
                                         Background="{DynamicResource BgDeepBrush}"
                                         Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         BorderThickness="1"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="{DynamicResource FontMono}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Padding="6,3"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static res:Strings.Button_ResetAllDefaults}"
                    MinWidth="150" Margin="0,0,8,0" Click="ResetAll_Click"/>
            <!-- IsCancel only: the button and Esc both close. No IsDefault — Enter
                 inside the filter box (outer or a row's inline editor) must not close
                 the whole dialog. -->
            <Button Content="{x:Static res:Strings.Button_Close}"
                    MinWidth="90" IsCancel="True"
                    Style="{StaticResource MozaButtonPrimary}"/>
        </StackPanel>
    </Grid>
</Window>
