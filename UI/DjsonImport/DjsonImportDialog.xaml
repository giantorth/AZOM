<Window x:Class="MozaPlugin.UI.DjsonImport.DjsonImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MozaPlugin.Resources"
        Title="{x:Static res:Strings.Title_DjsonImport}"
        Width="820" Height="600" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource SurfaceOpaqueBrush}"
        TextElement.Foreground="{DynamicResource TextBrush}"
        TextElement.FontFamily="{DynamicResource FontUi}"
        TextElement.FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MozaPlugin;component/Themes/MozaTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MozaPlugin;component/Themes/MozaIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button" BasedOn="{StaticResource MozaButton}"/>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Source file -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{x:Static res:Strings.Button_PickDjson}"
                    Margin="0,0,8,0" Click="PickFile_Click"/>
            <TextBlock Grid.Column="1" x:Name="SourceText" VerticalAlignment="Center"
                       Style="{StaticResource MutedHintText}"
                       Text="{x:Static res:Strings.Status_NoFileSelected}"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- Outcome data line -->
        <TextBlock Grid.Row="1" x:Name="SummaryText" Margin="0,0,0,10"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <!-- Conversion report -->
        <Border Grid.Row="2" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource BgDeepBrush}">
            <TextBox x:Name="ReportText"
                     IsReadOnly="True" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Courier New, monospace" FontSize="12"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource TextBrush}"
                     Padding="8"/>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ConvertButton" Content="{x:Static res:Strings.Button_Convert}"
                    MinWidth="120" IsEnabled="False" Margin="0,0,8,0"
                    Style="{StaticResource MozaButtonPrimary}"
                    Click="Convert_Click"/>
            <Button x:Name="StudioButton" Content="{x:Static res:Strings.Button_EditInStudio}"
                    ToolTip="{x:Static res:Strings.Tooltip_EditInStudio}"
                    MinWidth="140" IsEnabled="False" Margin="0,0,8,0"
                    Click="OpenStudio_Click"/>
            <Button Content="{x:Static res:Strings.Button_Close}" MinWidth="90"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
